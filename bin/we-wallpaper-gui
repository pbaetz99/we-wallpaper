    def build_bottom(self):
        bar = QFrame()
        bar.setObjectName("Bar")
        lay = QHBoxLayout(bar)
        lay.addWidget(QLabel(_("FPS:")))
        self.fps = QSpinBox()
        self.fps.setRange(1, 240)
        self.fps.setValue(int(self.cfg["fps"]))
        self.fps.setMaximumWidth(70)
        lay.addWidget(self.fps)

        lay.addWidget(QLabel(_("Lautstärke:")))
        self.vol = QSlider(Qt.Horizontal)
        self.vol.setRange(0, 100)
        self.vol.setValue(int(self.cfg["volume"]))
        self.vol.setMinimumWidth(120)
        self.vol.setMaximumWidth(160)
        self.vol_lbl = QLabel(str(self.cfg["volume"]))
        self.vol.valueChanged.connect(lambda v: self.vol_lbl.setText(str(v)))
        lay.addWidget(self.vol)
        lay.addWidget(self.vol_lbl)

        self.checks = {}
        for key, text, tip in (
            ("silent", "stumm", "Alle Wallpaper-Sounds abschalten"),
            ("noautomute", "kein Auto-Mute", "Nicht stummschalten, wenn andere Apps Ton abspielen"),
            ("disable_particles", "keine Partikel", "Partikeleffekte abschalten (spart GPU)"),
            ("disable_mouse", "keine Maus", "Mausinteraktion des Wallpapers abschalten"),
            ("disable_parallax", "kein Parallax", "Parallax-Effekt abschalten"),
            ("pause_on_lock", "Sperre-Pause",
             "Renderer einfrieren, solange der Bildschirm gesperrt ist.\n"
             "Spart ~19 W GPU, waehrend niemand hinsieht."),
            ("pause_on_maximized", "Maximiert-Pause",
             "Renderer einfrieren, wenn auf jedem Monitor mit Wallpaper ein\n"
             "maximiertes oder Vollbild-Fenster liegt - das Wallpaper ist dann\n"
             "ohnehin unsichtbar."),
            ("pause_on_fullscreen", "Vollbild-Pause",
             "Renderer einfrieren, solange ein Fenster im Vollbild laeuft.\n"
             "Eigene Erkennung per KWin-Skript, da KWin das dafuer noetige\n"
             "Wayland-Protokoll nicht anbietet."),
        ):
            cb = QCheckBox(_(text))
            cb.setToolTip(_(tip))
            cb.setChecked(bool(self.cfg.get(key)))
            self.checks[key] = cb
            lay.addWidget(cb)

        self.autostart = QCheckBox(_("Autostart"))
        self.autostart.setChecked(AUTOSTART.is_file())
        self.autostart.toggled.connect(self.on_autostart)
        lay.addWidget(self.autostart)
        self.service_cb = QCheckBox(_("systemd-Dienst"))
        self.service_cb.setToolTip(_("Startet Renderer und Vollbild-Pause als systemd-Benutzerdienste.\n"
            "Vorteil: systemd startet sie bei einem Absturz neu und bindet sie\n"
            "an die Plasma-Sitzung. Ersetzt den Autostart-Eintrag."))
        self.service_cb.setChecked(service_installed())
        self.service_cb.toggled.connect(self.on_service_toggle)
        lay.addWidget(self.service_cb)

        lay.addStretch(1)
        self.status = QLabel(_("…"))
        self.status.setObjectName("Pill")
        lay.addWidget(self.status)
        lay.addStretch(1)
        for text, slot, default in (("Anwenden", self.on_apply, True),
                                    ("Neustart", lambda: self.run_ctl("restart"), False),
                                    ("Stop", lambda: self.run_ctl("stop"), False)):
            b = QPushButton(_(text))
            b.clicked.connect(slot)
            b.setDefault(default)
            if default:
                b.setObjectName("Primary")
            lay.addWidget(b)
        return bar

    # ---------------- Grid
    def thumb_icon(self, path):
        if path is None:
            return QIcon()
        r = QImageReader(str(path))
        r.setAutoTransform(True)
        img = r.read()
        if img.isNull():
            return QIcon()
        return QIcon(QPixmap.fromImage(img).scaled(self.thumb, Qt.KeepAspectRatio,
                                                   Qt.SmoothTransformation))

    def populate_grid(self):
        favs = set(self.cfg.get("favorites") or [])
        keys = {
            _("Titel"): lambda w: w["title"].lower(),
            _("Zuletzt hinzugefügt"): lambda w: -w["mtime"],
            _("Größe"): lambda w: -w["size"],
            _("Typ"): lambda w: (w["type"], w["title"].lower()),
            _("Favoriten zuerst"): lambda w: (w["id"] not in favs, w["title"].lower()),
            _("Seitenverhältnis"): lambda w: (-w["aspect"], w["title"].lower()),
        }
        order = keys.get(self.sort_box.currentText(), keys[_("Titel")])
        self.grid.clear()
        for w in sorted(self.wallpapers, key=order):
            label = w["title"] if len(w["title"]) <= 34 else w["title"][:33] + "…"
            if w["id"] in favs:
                label = "★ " + label
            if w["id"] in set(self.cfg.get("hidden") or []):
                label += _("  (versteckt)")
            if not w["ok"]:
                label += _("  ⚠ defekt")
            it = QListWidgetItem(self.thumb_icon(w["preview"]), label)
            it.setData(Qt.UserRole, w["id"])
            mb = w["size"] / 1024 / 1024
            it.setToolTip(f'{w["title"]}\nID {w["id"]} · {w["type"]} · {mb:.1f} MB'
                          + ("\n" + _("Tags: {tags}").format(tags=", ".join(w["tags"])) if w["tags"] else "")
                          + ("" if w["ok"] else "\n\n" + _("Defekt: keine Wallpaper-Datei.")))
            if not w["ok"]:
                it.setFlags(it.flags() & ~Qt.ItemIsEnabled)
            self.grid.addItem(it)
        self.apply_filter()

    def apply_filter(self):
        needle = self.search.text().strip().lower()
        tag = self.tag_box.currentText()
        typ = self.type_box.currentText()
        favs = set(self.cfg.get("favorites") or [])
        hidden = set(self.cfg.get("hidden") or [])
        mon_aspect = 0.0
        name = self.current_monitor() if hasattr(self, "mon_list") else None
        for n, mw, mh, _e in getattr(self, "mon_info", []):
            if n == name and mh:
                mon_aspect = mw / mh
        shown = 0
        for i in range(self.grid.count()):
            it = self.grid.item(i)
            w = self.by_id[it.data(Qt.UserRole)]
            ok = True
            if needle and needle not in (w["title"] + " " + w["description"]
                                         + " " + w["id"]).lower():
                ok = False
            if tag != _("Alle") and tag not in w["tags"]:
                ok = False
            if typ != _("Alle") and w["type"] != typ:
                ok = False
            if self.fav_only.isChecked() and w["id"] not in favs:
                ok = False
            if w["id"] in hidden and not self.show_hidden.isChecked():
                ok = False
            if self.aspect_only.isChecked() and mon_aspect:
                # Unbekannte Aufloesung gilt als "passt nicht", sonst waere der
                # Filter wirkungslos - so steht es auch im Tooltip.
                if not w["aspect"]:
                    ok = False
                elif abs(w["aspect"] - mon_aspect) / mon_aspect > 0.12:
                    ok = False
            it.setHidden(not ok)
            shown += ok
        self.count_label.setText(
            _("<b>Wallpaper</b> — {shown} von {total} (Doppelklick weist dem gewählten Monitor zu)")
            .format(shown=shown, total=len(self.wallpapers)))

    def visible_ids(self):
        return [self.grid.item(i).data(Qt.UserRole) for i in range(self.grid.count())
                if not self.grid.item(i).isHidden()
                and self.by_id[self.grid.item(i).data(Qt.UserRole)]["ok"]]

    # ---------------- Monitore
    def fill_monitors(self):
        self.mon_list.clear()
        self.mon_info = detect_monitors()
        self.monitors = [m[0] for m in self.mon_info]
        for _ in self.mon_info:
            self.mon_list.addItem(QListWidgetItem(""))
        for i in range(len(self.mon_info)):
            self.refresh_monitor_row(i)

    def refresh_monitor_row(self, idx):
        name, w, h, enabled = self.mon_info[idx]
        sc = self.cfg["screens"].get(name) or {}
        wid = sc.get("id")
        none = _("— keins —")
        title = self.by_id.get(wid, {}).get("title", none) if wid else none
        it = self.mon_list.item(idx)
        it.setText(f"{name}   {w}×{h}{'' if enabled else '   ' + _('(aus)')}\n{title}")
        if not enabled:
            it.setForeground(QColor(150, 150, 150))
            it.setToolTip(_("In den KDE-Anzeigeeinstellungen deaktiviert.\n"
                          "Zuweisung wird gespeichert, beim Start aber übersprungen."))

    def current_monitor(self):
        i = self.mon_list.currentRow()
        return self.monitors[i] if 0 <= i < len(self.monitors) else None

    def on_monitor_selected(self, _idx):
        name = self.current_monitor()
        if not name:
            return
        sc = self.cfg["screens"].get(name) or {}
        for box, key, default in ((self.scaling_box, "scaling", "fill"),
                                  (self.clamp_box, "clamp", "clamp")):
            box.blockSignals(True)
            box.setCurrentText(sc.get(key) or default)
            box.blockSignals(False)
        wid = sc.get("id")
        if wid:
            for i in range(self.grid.count()):
                if self.grid.item(i).data(Qt.UserRole) == wid:
                    self.grid.setCurrentRow(i)
                    break
        self.show_details(self.grid.currentItem())

    def set_screen_field(self, key, value):
        name = self.current_monitor()
        if name and name in self.cfg["screens"]:
            self.cfg["screens"][name][key] = value

    def assign_selected(self):
        name = self.current_monitor()
        it = self.grid.currentItem()
        if not name or it is None:
            return
        wid = it.data(Qt.UserRole)
        if not self.by_id[wid]["ok"]:
            QMessageBox.warning(self, _("Defektes Wallpaper"), _("Dieses Item enthält keine Wallpaper-Datei."))
            return
        old = self.cfg["screens"].get(name) or {}
        self.cfg["screens"][name] = {
            "id": wid,
            "scaling": self.scaling_box.currentText(),
            "clamp": self.clamp_box.currentText(),
            "properties": old.get("properties", {}) if old.get("id") == wid else {},
        }
        self.refresh_monitor_row(self.mon_list.currentRow())
        self.show_details(it)

    def clear_monitor(self):
        name = self.current_monitor()
        if name and name in self.cfg["screens"]:
            del self.cfg["screens"][name]
            self.refresh_monitor_row(self.mon_list.currentRow())
            self.show_details(self.grid.currentItem())

    # ---------------- Detailbereich
    def show_details(self, item):
        if self.movie:
            self.movie.stop()
            self.movie = None
        if item is None:
            self.det_title.setText("")
            self.det_meta.setText("")
            self.desc.setPlainText("")
            self.prev_label.setText(_("—"))
            self.props.build({}, {}, False)
            self.prop_hint.setText("")
            return
        w = self.by_id[item.data(Qt.UserRole)]
        self.det_title.setText(f'<b style="font-size:13pt">{w["title"]}</b>')
        tags = ", ".join(w["tags"]) or "—"
        if w["rw"]:
            res = f'{w["rw"]}×{w["rh"]}'
            mon = next(((mw, mh) for n, mw, mh, _e in self.mon_info
                        if n == self.current_monitor()), None)
            if mon and mon[1] and w["aspect"]:
                diff = abs(w["aspect"] - mon[0] / mon[1]) / (mon[0] / mon[1])
                res += (' <span style="color:#5ec98a">· ' + _("passt genau") + '</span>'
                        if diff <= 0.03 else
                        (' <span style="color:#c9a227">· ' + _("wird beschnitten") + '</span>'
                         if diff > 0.12 else ""))
        else:
            res = '<span style="color:#9a9ab0">' + _("nicht ermittelbar") + '</span>'
        self.det_meta.setText(
            _("ID {id}  ·  Typ <b>{type}</b>  ·  {mb:.1f} MB").format(
                id=w["id"], type=w["type"], mb=w["size"] / 1024 / 1024)
            + "<br>" + _("Auflösung:") + " " + res
            + "<br>" + _("Tags: {tags}  ·  Properties: {n}").format(tags=tags, n=len(w["props"])))
        self.desc.setPlainText(w["description"] or _("(keine Beschreibung)"))

        if w["preview"] and w["preview"].suffix.lower() == ".gif":
            self.movie = QMovie(str(w["preview"]))
            self.movie.setScaledSize(QSize(400, 190 * 400 // max(1, 400)))
            self.prev_label.setMovie(self.movie)
            self.movie.start()
        elif w["preview"]:
            pm = QPixmap(str(w["preview"]))
            self.prev_label.setPixmap(pm.scaled(QSize(400, 190), Qt.KeepAspectRatio,
                                                Qt.SmoothTransformation))
        else:
            self.prev_label.setText(_("keine Vorschau"))

        name = self.current_monitor()
        sc = self.cfg["screens"].get(name) or {}
        assigned = sc.get("id") == w["id"]
        self.props.build(w["props"], sc.get("properties", {}) if assigned else {},
                         editable=assigned)
        favs = set(self.cfg.get("favorites") or [])
        hid = set(self.cfg.get("hidden") or [])
        for btn, member in ((self.fav_btn, w["id"] in favs),
                            (self.hide_btn, w["id"] in hid)):
            btn.blockSignals(True)
            btn.setChecked(member)
            btn.blockSignals(False)
        spans = self.cfg.get("spans") or []
        self.span_cb.blockSignals(True)
        self.span_cb.setChecked(bool(spans))
        self.span_cb.blockSignals(False)
        self.prop_hint.setText(
            "" if assigned else
            '<i style="color:#c9a227">' + _("Nur Vorschau — erst dem Monitor zuweisen, um Einstellungen zu ändern.") + '</i>')

    def open_current_url(self):
        it = self.grid.currentItem()
        if it:
            subprocess.Popen(["xdg-open", self.by_id[it.data(Qt.UserRole)]["url"]])

    def on_property_changed(self, key, value):
        name = self.current_monitor()
        if not name or name not in self.cfg["screens"]:
            return
        self.cfg["screens"][name].setdefault("properties", {})[key] = value

    # ---------------- Diashow
    def on_rot_toggle(self, on):
        self.cfg["rotation"]["enabled"] = on
        self.update_pool_info()

    def set_pool(self):
        ids = self.visible_ids()
        self.cfg["rotation"]["pool"] = ids
        self.update_pool_info()
        QMessageBox.information(self, _("Diashow-Pool"),
                                _("{n} Wallpaper übernommen.").format(n=len(ids)))

    def update_pool_info(self):
        n = len(self.cfg["rotation"].get("pool") or [])
        self.rot_info.setText(_("Pool: {n} Wallpaper").format(n=n)
                              + ("" if n > 1 else _("  (mind. 2 nötig)")))

    # ---------------- Aktionen
    def collect(self):
        self.cfg["fps"] = self.fps.value()
        self.cfg["volume"] = self.vol.value()
        for key, cb in self.checks.items():
            self.cfg[key] = cb.isChecked()
        self.cfg["rotation"]["enabled"] = self.rot_on.isChecked()
        self.cfg["rotation"]["minutes"] = self.rot_min.value()

    def on_apply(self):
        self.collect()
        if not self.cfg["screens"]:
            QMessageBox.warning(self, _("Nichts ausgewählt"), _("Mindestens ein Monitor braucht ein Wallpaper."))
            return
        save_conf(self.cfg)
        if (self.cfg.get("backend") or "native") == "kde-plugin":
            self.on_backend_switch()
            return
        self.run_ctl("restart")

    def run_ctl(self, action):
        self.status.setText(_("… läuft an"))
        QApplication.processEvents()
        try:
            subprocess.run([str(CTL), action], timeout=120,
                           capture_output=True, text=True)
        except Exception as e:
            QMessageBox.critical(self, _("Fehler"), str(e))
        self.refresh_status()

    def on_autostart(self, checked):
        if checked:
            AUTOSTART.parent.mkdir(parents=True, exist_ok=True)
            AUTOSTART.write_text(
                "[Desktop Entry]\nType=Application\n"
                "Name=Wallpaper Engine (linux-wallpaperengine)\n"
                "Comment=Animierte Wallpaper-Engine-Hintergründe\n"
                f'Exec=/bin/bash -c "sleep 5; exec {CTL} start"\n'
                "Icon=preferences-desktop-wallpaper\nTerminal=false\n"
                "X-GNOME-Autostart-enabled=true\nX-KDE-autostart-after=panel\n",
                encoding="utf-8")
        elif AUTOSTART.is_file():
            AUTOSTART.unlink()

    # ---------------- Favoriten, Verstecken, Kontextmenü
    def _toggle_in(self, key, wid, on):
        lst = self.cfg.setdefault(key, [])
        if on and wid not in lst:
            lst.append(wid)
        elif not on and wid in lst:
            lst.remove(wid)
        save_conf(self.cfg)
        self.populate_grid()
        self.select_id(wid)

    def toggle_favorite(self):
        it = self.grid.currentItem()
        if it:
            self._toggle_in("favorites", it.data(Qt.UserRole),
                            self.fav_btn.isChecked())

    def toggle_hidden(self):
        it = self.grid.currentItem()
        if it:
            self._toggle_in("hidden", it.data(Qt.UserRole),
                            self.hide_btn.isChecked())

    def grid_menu(self, pos):
        it = self.grid.itemAt(pos)
        if it is None:
            return
        self.grid.setCurrentItem(it)
        wid = it.data(Qt.UserRole)
        favs = set(self.cfg.get("favorites") or [])
        hidden = set(self.cfg.get("hidden") or [])
        m = QMenu(self)
        m.addAction(_("Diesem Monitor zuweisen")).triggered.connect(self.assign_selected)
        m.addAction(_("Live-Vorschau rendern")).triggered.connect(self.render_preview)
        m.addSeparator()
        a_fav = m.addAction(_("Favorit"))
        a_fav.setCheckable(True)
        a_fav.setChecked(wid in favs)
        a_fav.triggered.connect(
            lambda on, w=wid: self._toggle_in("favorites", w, on))
        a_hid = m.addAction(_("Verstecken"))
        a_hid.setCheckable(True)
        a_hid.setChecked(wid in hidden)
        a_hid.triggered.connect(
            lambda on, w=wid: self._toggle_in("hidden", w, on))
        m.addSeparator()
        m.addAction(_("Workshop-Seite öffnen")).triggered.connect(self.open_current_url)
        m.exec(self.grid.mapToGlobal(pos))

    def select_id(self, wid):
        for i in range(self.grid.count()):
            if self.grid.item(i).data(Qt.UserRole) == wid:
                self.grid.setCurrentRow(i)
                self.grid.scrollToItem(self.grid.item(i))
                return True
        return False

    def reset_properties(self):
        name = self.current_monitor()
        it = self.grid.currentItem()
        if not name or it is None:
            return
        sc = self.cfg["screens"].get(name) or {}
        if sc.get("id") != it.data(Qt.UserRole):
            QMessageBox.information(
                self, _("Nicht zugewiesen"), _("Standardwerte gelten für das dem Monitor zugewiesene Wallpaper."))
            return
        sc["properties"] = {}
        self.show_details(it)
        self.status.setText(_("Properties auf Standardwerte zurückgesetzt"))

    # ---------------- Span über mehrere Monitore
    def on_span_toggle(self, on):
        active = [n for n, _w, _h, en in self.mon_info if en]
        if on:
            if len(active) < 2:
                self.span_cb.blockSignals(True)
                self.span_cb.setChecked(False)
                self.span_cb.blockSignals(False)
                QMessageBox.information(
                    self, _("Zwei Monitore nötig"),
                    _("Ein Span braucht mindestens zwei eingeschaltete Monitore.\nAktuell aktiv: {active}.")
                    .format(active=", ".join(active) or _("keiner")))
                return
            it = self.grid.currentItem()
            if it is None:
                return
            self.cfg["spans"] = [{
                "outputs": active, "id": it.data(Qt.UserRole),
                "scaling": self.scaling_box.currentText(),
                "clamp": self.clamp_box.currentText(), "properties": {},
            }]
            for n in active:
                self.cfg["screens"].pop(n, None)
        else:
            self.cfg["spans"] = []
        for i in range(len(self.mon_info)):
            self.refresh_monitor_row(i)

    # ---------------- Backend (eigener Renderer / KDE-Plugin)
    def refresh_backend_info(self):
        cur = self.cfg.get("backend") or "native"
        i = self.backend_box.findData(cur)
        if i >= 0:
            self.backend_box.blockSignals(True)
            self.backend_box.setCurrentIndex(i)
            self.backend_box.blockSignals(False)
        inst = kde_plugin_installed()
        self.backend_info.setText(
            (_("aktiv: KDE-Plugin") if cur == "kde-plugin" else _("aktiv: eigener Renderer"))
            + "  ·  " + (_("Plugin installiert") if inst else _("Plugin nicht installiert")))

    def on_backend_switch(self):
        target = self.backend_box.currentData()
        if target == "kde-plugin" and not kde_plugin_installed():
            box = QMessageBox(self)
            box.setWindowTitle(_("KDE-Plugin nicht installiert"))
            box.setText(_("Das wallpaper-engine-kde-plugin ist nicht installiert.\n\nFedora/Nobara:\n"
                          "  sudo dnf copr enable kylegospo/wallpaper-engine-kde-plugin\n"
                          "  sudo dnf install wallpaper-engine-kde-plugin\n\n"
                          "Andere Distributionen: siehe Projektseite."))
            open_btn = box.addButton(_("Projektseite öffnen"), QMessageBox.ActionRole)
            box.addButton(QMessageBox.Ok)
            box.exec()
            if box.clickedButton() is open_btn:
                subprocess.Popen(["xdg-open", KDE_PLUGIN_URL])
            self.refresh_backend_info()
            return
        self.collect()
        save_conf(self.cfg)
        self.status.setText(_("… läuft an"))
        QApplication.processEvents()
        try:
            r = subprocess.run([str(CTL), "backend", target], timeout=120,
                               capture_output=True, text=True)
            if r.returncode != 0:
                QMessageBox.critical(self, _("Fehler"), (r.stderr or r.stdout).strip()[:600])
        except Exception as e:
            QMessageBox.critical(self, _("Fehler"), str(e))
        self.cfg = load_conf()
        self.refresh_backend_info()
        self.refresh_status()
        self.status.setText(_("Backend gewechselt"))

    # ---------------- systemd
    def on_service_toggle(self, on):
        action = "install-service" if on else "uninstall-service"
        self.status.setText(_("Dienst wird eingerichtet …"))
        QApplication.processEvents()
        r = subprocess.run([str(CTL), action], capture_output=True, text=True,
                           timeout=120)
        if r.returncode != 0:
            QMessageBox.critical(self, _("systemd"), r.stderr.strip() or _("Fehlgeschlagen"))
            self.service_cb.blockSignals(True)
            self.service_cb.setChecked(service_installed())
            self.service_cb.blockSignals(False)
        else:
            self.autostart.blockSignals(True)
            self.autostart.setChecked(AUTOSTART.is_file())
            self.autostart.blockSignals(False)
        self.refresh_status()

    # ---------------- Ansicht
    def on_thumb_size(self):
        val = self.thumb_slider.value()
        self.thumb = QSize(val, int(val * 9 / 16))
        self.grid.setIconSize(self.thumb)
        self.grid.setGridSize(QSize(self.thumb.width() + 26,
                                    self.thumb.height() + 62))
        cur = self.grid.currentItem()
        wid = cur.data(Qt.UserRole) if cur else None
        self.populate_grid()
        if wid:
            self.select_id(wid)

    # ---------------- Zustand merken
    def restore_ui(self):
        st = self.ui
        if st.get("geometry"):
            try:
                self.restoreGeometry(QByteArray.fromBase64(
                    st["geometry"].encode("ascii")))
            except Exception:
                pass
        for widget, key in ((self.search, "search"), (self.tag_box, "tag"),
                            (self.type_box, "typ"), (self.sort_box, "sort")):
            val = st.get(key)
            if val in (None, ""):
                continue
            if isinstance(widget, QLineEdit):
                widget.setText(val)
            elif isinstance(val, int):
                if 0 <= val < widget.count():
                    widget.setCurrentIndex(val)
            elif widget.findText(val) >= 0:
                widget.setCurrentText(val)
        row = int(st.get("monitor_row") or 0)
        if 0 <= row < self.mon_list.count():
            self.mon_list.setCurrentRow(row)
        if st.get("last_id"):
            self.select_id(st["last_id"])
        tabs = self.findChildren(QTabWidget)
        if tabs:
            tabs[0].setCurrentIndex(int(st.get("tab") or 0))

    def maybe_save_ui(self):
        """Sichert den Zustand nur bei Aenderung - so ueberlebt er auch ein
        hartes Beenden, ohne bei jedem Statusabruf zu schreiben."""
        before = json.dumps(self.ui, sort_keys=True)
        self.collect_ui(write=False)
        after = json.dumps(self.ui, sort_keys=True)
        if before != after:
            save_ui(self.ui)

    def collect_ui(self, write=True):
        cur = self.grid.currentItem()
        tabs = self.findChildren(QTabWidget)
        self.ui.update({
            "geometry": bytes(self.saveGeometry().toBase64()).decode("ascii"),
            "thumb": self.thumb_slider.value(),
            "sort": self.sort_box.currentIndex(),
            "tag": self.tag_box.currentText(),
            "typ": self.type_box.currentText(),
            "search": self.search.text(),
            "monitor_row": self.mon_list.currentRow(),
            "only_favs": self.fav_only.isChecked(),
            "show_hidden": self.show_hidden.isChecked(),
            "aspect_only": self.aspect_only.isChecked(),
            "tab": tabs[0].currentIndex() if tabs else 0,
            "last_id": cur.data(Qt.UserRole) if cur else "",
        })
        if write:
            save_ui(self.ui)

    # ---------------- Profile
    def refresh_profiles(self):
        self.prof_box.blockSignals(True)
        self.prof_box.clear()
        self.prof_box.addItem(PROFILE_PLACEHOLDER)
        for name in sorted(self.cfg.get("profiles") or {}):
            self.prof_box.addItem(name)
        self.prof_box.blockSignals(False)

    def on_profile_selected(self, name):
        if not name or name == PROFILE_PLACEHOLDER:
            return
        saved = (self.cfg.get("profiles") or {}).get(name)
        if not saved:
            return
        for key in DEFAULT_CONF:
            if key != "profiles" and key in saved:
                self.cfg[key] = json.loads(json.dumps(saved[key]))
        self.apply_conf_to_ui()

    def apply_conf_to_ui(self):
        """Uebertraegt die Konfiguration zurueck in alle Bedienelemente."""
        self.fps.setValue(int(self.cfg.get("fps", 30)))
        self.vol.setValue(int(self.cfg.get("volume", 15)))
        for key, cb in self.checks.items():
            cb.blockSignals(True)
            cb.setChecked(bool(self.cfg.get(key)))
            cb.blockSignals(False)
        rot = self.cfg.get("rotation") or {}
        self.rot_on.blockSignals(True)
        self.rot_on.setChecked(bool(rot.get("enabled")))
        self.rot_on.blockSignals(False)
        self.rot_min.setValue(int(rot.get("minutes", 30)))
        self.update_pool_info()
        for i in range(len(self.mon_info)):
            self.refresh_monitor_row(i)
        self.on_monitor_selected(self.mon_list.currentRow())
        if getattr(self, "act_pause", None):
            self.act_pause.blockSignals(True)
            self.act_pause.setChecked(bool(self.cfg.get("pause_on_fullscreen")))
            self.act_pause.blockSignals(False)

    def save_profile(self):
        suggestion = self.prof_box.currentText()
        if suggestion == PROFILE_PLACEHOLDER:
            suggestion = ""
        name, ok = QInputDialog.getText(self, _("Profil speichern"), _("Name:"),
                                        text=suggestion)
        name = (name or "").strip()
        if not ok or not name or name == PROFILE_PLACEHOLDER:
            return
        self.collect()
        snapshot = {k: json.loads(json.dumps(self.cfg[k]))
                    for k in DEFAULT_CONF if k != "profiles" and k in self.cfg}
        self.cfg.setdefault("profiles", {})[name] = snapshot
        save_conf(self.cfg)
        self.refresh_profiles()
        self.prof_box.setCurrentText(name)
        self.status.setText(_("Profil „{name}“ gespeichert").format(name=name))

    def delete_profile(self):
        name = self.prof_box.currentText()
        if name == PROFILE_PLACEHOLDER or name not in (self.cfg.get("profiles") or {}):
            return
        if QMessageBox.question(self, _("Profil löschen"),
                                _("Profil „{name}“ wirklich löschen?").format(name=name)) != \
                QMessageBox.StandardButton.Yes:
            return
        del self.cfg["profiles"][name]
        save_conf(self.cfg)
        self.refresh_profiles()

    # ---------------- Live-Vorschau
    def render_preview(self):
        it = self.grid.currentItem()
        if it is None or self.render_proc is not None:
            return
        wid = it.data(Qt.UserRole)
        if not self.by_id[wid]["ok"]:
            return
        name = self.current_monitor()
        geo = next(((mw, mh) for n, mw, mh, _e in self.mon_info if n == name),
                   (1920, 1080))
        aspect = (geo[0] / geo[1]) if geo[1] else 16 / 9
        rw = 960
        rh = max(120, int(round(rw / aspect)))
        CACHE.mkdir(parents=True, exist_ok=True)
        out = CACHE / f"preview_{wid}.png"
        try:
            out.unlink()
        except OSError:
            pass
        sc = self.cfg["screens"].get(name) or {}
        assigned = sc.get("id") == wid
        scaling = (sc.get("scaling") if assigned
                   else self.scaling_box.currentText()) or "fill"
        args = ["--window", f"0x0x{rw}x{rh}", "--bg", wid, "--scaling", scaling,
                "--silent", "--screenshot", str(out), "--screenshot-delay", "60"]
        if assigned and sc.get("clamp"):
            args += ["--clamp", sc["clamp"]]
        for k, val in (sc.get("properties") or {} if assigned else {}).items():
            args += ["--set-property", f"{k}={val}"]

        self.render_target = out
        self.render_btn.setEnabled(False)
        self.render_btn.setText(_("rendert …"))
        self.render_proc = QProcess(self)
        self.render_proc.finished.connect(self.render_finished)
        self.render_proc.errorOccurred.connect(lambda _e: self.render_finished())
        self.render_proc.start(str(RENDERER), args)
        self.render_timeout = QTimer(self)
        self.render_timeout.setSingleShot(True)
        self.render_timeout.timeout.connect(self.kill_render)
        self.render_timeout.start(120000)

    def kill_render(self):
        if self.render_proc is not None:
            self.render_proc.kill()

    def render_finished(self, *_):
        if getattr(self, "render_timeout", None):
            self.render_timeout.stop()
        self.render_btn.setEnabled(True)
        self.render_btn.setText(_("Live-Vorschau rendern"))
        self.render_proc = None
        out = self.render_target
        if out and out.is_file() and out.stat().st_size > 0:
            if self.movie:
                self.movie.stop()
                self.movie = None
            pm = QPixmap(str(out))
            self.prev_label.setPixmap(pm.scaled(QSize(400, 190), Qt.KeepAspectRatio,
                                                Qt.SmoothTransformation))
            txt = self.det_meta.text().split("<br><i>")[0]
            self.det_meta.setText(
                txt + "<br><i>" + _("Live-Vorschau gerendert")
                + f" ({pm.width()}×{pm.height()})</i>")
        else:
            QMessageBox.warning(
                self, _("Vorschau fehlgeschlagen"), _("Der Renderer hat kein Bild geliefert. Web- und manche "
                "Video-Wallpaper unterstützen den Schnappschuss nicht."))

    # ---------------- Tray
    def build_tray(self):
        self.tray = None
        self.act_pause = None
        if not QSystemTrayIcon.isSystemTrayAvailable():
            return
        icon = QIcon.fromTheme("preferences-desktop-wallpaper")
        if icon.isNull():
            icon = self.style().standardIcon(QStyle.SP_DesktopIcon)
        self.tray = QSystemTrayIcon(icon, self)
        menu = QMenu(self)
        menu.addAction(_("Fenster zeigen")).triggered.connect(self.show_normal)
        menu.addSeparator()
        menu.addAction(_("Start / Neustart")).triggered.connect(
            lambda: self.run_ctl("restart"))
        menu.addAction(_("Stop")).triggered.connect(lambda: self.run_ctl("stop"))
        self.act_pause = menu.addAction(_("Vollbild-Pause"))
        self.act_pause.setCheckable(True)
        self.act_pause.setChecked(bool(self.cfg.get("pause_on_fullscreen")))
        self.act_pause.toggled.connect(self.on_tray_pause)
        menu.addSeparator()
        menu.addAction(_("Beenden")).triggered.connect(self.quit_app)
        self.tray_menu = menu
        self.tray.setContextMenu(menu)
        self.tray.activated.connect(self.tray_activated)
        self.tray.setToolTip(_("Wallpaper Engine"))
        self.tray.show()

    def quit_app(self):
        self.collect_ui()
        QApplication.quit()

    def show_normal(self):
        self.showNormal()
        self.raise_()
        self.activateWindow()

    def tray_activated(self, reason):
        if reason in (QSystemTrayIcon.Trigger, QSystemTrayIcon.DoubleClick):
            if self.isVisible():
                self.hide()
            else:
                self.show_normal()

    def on_tray_pause(self, checked):
        cb = self.checks.get("pause_on_fullscreen")
        if cb:
            cb.setChecked(checked)
        self.collect()
        save_conf(self.cfg)
        self.run_ctl("restart")

    def closeEvent(self, event):
        self.collect_ui()
        if self.tray is not None:
            event.ignore()
            self.hide()
            self.tray.showMessage("Wallpaper Engine",
                                  _("Läuft im Systemabschnitt weiter."),
                                  QSystemTrayIcon.Information, 4000)
        else:
            super().closeEvent(event)

    def refresh_status(self):
        try:
            out = subprocess.run([str(CTL), "status"], timeout=15,
                                 capture_output=True, text=True).stdout
        except Exception:
            out = ""
        first = out.splitlines()[0] if out else ""
        if first.startswith("running"):
            self.status.setText(
                '<span style="color:#3fb950">● ' + _("läuft") + '</span> — ' + first[8:])
        else:
            self.status.setText('<span style="color:#f85149">● ' + _("gestoppt") + '</span>')
        if self.tray is not None:
            self.tray.setToolTip("Wallpaper Engine — "
                                 + (first or _("gestoppt")))


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Wallpaper Engine")
    app.setStyleSheet(build_qss())
    app.setWindowIcon(QIcon.fromTheme("preferences-desktop-wallpaper"))
    if not WORKSHOP.is_dir():
        QMessageBox.critical(None, _("Kein Workshop-Ordner"), _("Fehlt:\n{path}").format(path=WORKSHOP))
        return 1
    w = Window()
    w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
