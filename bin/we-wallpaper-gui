# ------------------------------------------------------------------ Datenzugriff
RESCACHE = CACHE / "resolutions.json"


def _load_rescache():
    try:
        return json.loads(RESCACHE.read_text(encoding="utf-8"))
    except Exception:
        return {}


def media_resolution(folder, project, cache):
    """Echte Aufloesung des Wallpapers.

    Nur bei Video-Wallpapern bestimmbar (per ffprobe). Scene- und Web-Wallpaper
    geben ihre Groesse nicht bekannt; das Vorschaubild taugt nicht als Ersatz,
    weil Steam es quadratisch zuschneidet. Ergebnis wird zwischengespeichert.
    """
    content = project.get("file") or ""
    if (project.get("type") or "").lower() != "video" or not content:
        return 0, 0
    path = folder / content
    if not path.is_file():
        return 0, 0
    key = f"{folder.name}:{int(path.stat().st_mtime)}"
    if key in cache:
        return tuple(cache[key])
    try:
        r = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries", "stream=width,height", "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, timeout=20)
        wh = [int(x) for x in r.stdout.strip().split(",")[:2]]
        res = (wh[0], wh[1]) if len(wh) == 2 else (0, 0)
    except Exception:
        res = (0, 0)
    cache[key] = list(res)
    return res


def load_wallpapers():
    items = []
    if not WORKSHOP.is_dir():
        return items
    cache = _load_rescache()
    cache_before = len(cache)
    for d in sorted(WORKSHOP.iterdir()):
        pj = d / "project.json"
        if not d.is_dir() or not pj.is_file():
            continue
        try:
            j = json.loads(pj.read_text(encoding="utf-8", errors="replace"))
        except Exception:
            j = {}
        preview_name = j.get("preview", "preview.jpg")
        content = j.get("file", "")
        has_content = bool(content) and (d / content).exists()
        if not has_content:
            has_content = any(
                p.name != preview_name and p.name != "project.json"
                and p.suffix.lower() in (".pkg", ".mp4", ".webm", ".json", ".html", ".gif")
                for p in d.iterdir())
        prev = d / preview_name
        size = sum(p.stat().st_size for p in d.rglob("*") if p.is_file())
        rw, rh = media_resolution(d, j, cache)
        items.append({
            "id": d.name,
            "title": j.get("title") or d.name,
            "type": (j.get("type") or "?").lower(),
            "tags": j.get("tags") or [],
            "description": j.get("description") or "",
            "url": j.get("workshopurl") or f"{WORKSHOP_URL}",
            "preview": prev if prev.is_file() else None,
            "props": ((j.get("general") or {}).get("properties") or {}),
            "ok": has_content,
            "size": size,
            "mtime": d.stat().st_mtime,
            "rw": rw, "rh": rh,
            "aspect": (rw / rh) if rw and rh else 0.0,
        })
    if len(cache) != cache_before:
        try:
            CACHE.mkdir(parents=True, exist_ok=True)
            RESCACHE.write_text(json.dumps(cache), encoding="utf-8")
        except OSError:
            pass
    return items


def detect_monitors():
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True,
                             text=True, timeout=5).stdout
        res = []
        for o in json.loads(out).get("outputs", []):
            if not o.get("connected"):
                continue
            sz = o.get("size") or {}
            res.append((o.get("name", "?"), sz.get("width", 0), sz.get("height", 0),
                        bool(o.get("enabled"))))
        if res:
            return res
    except Exception:
        pass
    return [(s.name(), s.geometry().width(), s.geometry().height(), True)
            for s in QGuiApplication.screens()]


DEFAULT_CONF = {
    "screens": {}, "fps": 30, "volume": 15, "silent": False, "noautomute": True,
    "no_audio_processing": False, "disable_particles": False, "disable_mouse": False,
    "disable_parallax": False, "no_fullscreen_pause": False,
    "pause_on_fullscreen": True, "pause_on_lock": True, "pause_on_maximized": True,
    "rotation": {"enabled": False, "minutes": 30, "pool": [], "order": "random"},
    "profiles": {}, "spans": [], "favorites": [], "hidden": [], "backend": "native",
}


UI_DEFAULTS = {
    "geometry": "", "thumb": 220, "sort": 0, "tag": "", "typ": "",
    "search": "", "monitor_row": 0, "only_favs": False, "show_hidden": False,
    "aspect_only": False, "tab": 0, "last_id": "",
}


def make_arrow(path, color):
    """Zeichnet ein kleines Dreieck als PNG fuer die Auswahlfelder."""
    from PySide6.QtGui import QPainter, QPainterPath, QPolygonF
    from PySide6.QtCore import QPointF
    pm = QPixmap(22, 14)
    pm.fill(Qt.transparent)
    pen = QPainter(pm)
    pen.setRenderHint(QPainter.Antialiasing)
    poly = QPolygonF([QPointF(3, 4), QPointF(19, 4), QPointF(11, 11)])
    pp = QPainterPath()
    pp.addPolygon(poly)
    pen.fillPath(pp, QColor(color))
    pen.end()
    path.parent.mkdir(parents=True, exist_ok=True)
    pm.save(str(path), "PNG")
    return path


def build_qss():
    """Stylesheet mit den Pfaden der erzeugten Pfeilbilder."""
    normal = make_arrow(CACHE / "arrow.png", "#9a9ab0")
    accent = make_arrow(CACHE / "arrow_accent.png", ACCENT)
    return (QSS.replace("ARROW_NORMAL", normal.as_posix())
               .replace("ARROW_ACCENT", accent.as_posix()))


def service_installed():
    return (HOME / ".config/systemd/user/we-wallpaper.service").is_file()


def load_ui():
    st = dict(UI_DEFAULTS)
    if UISTATE.is_file():
        try:
            st.update(json.loads(UISTATE.read_text(encoding="utf-8")))
        except Exception:
            pass
    return st


def save_ui(st):
    UISTATE.parent.mkdir(parents=True, exist_ok=True)
    UISTATE.write_text(json.dumps(st, indent=2, ensure_ascii=False), encoding="utf-8")


def load_conf():
    cfg = json.loads(json.dumps(DEFAULT_CONF))
    if CONF.is_file():
        try:
            cfg.update(json.loads(CONF.read_text(encoding="utf-8")))
        except Exception:
            pass
    rot = dict(DEFAULT_CONF["rotation"])
    rot.update(cfg.get("rotation") or {})
    cfg["rotation"] = rot
    return cfg


def save_conf(cfg):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps(cfg, indent=2, ensure_ascii=False), encoding="utf-8")


# ------------------------------------------------------------------ Bedingungen
COND_RE = re.compile(r"(\w+)\.value\s*(>=|<=|==|!=|>|<)\s*([-\d.]+)")


def cond_ok(condition, values):
    """Wertet WE-Bedingungen wie 'numwaterfalls.value >= 1' aus (&&/|| unterstuetzt)."""
    if not condition:
        return True
    def one(m):
        name, op, num = m.group(1), m.group(2), float(m.group(3))
        try:
            cur = float(values.get(name, 0))
        except (TypeError, ValueError):
            return True
        return {">=": cur >= num, "<=": cur <= num, ">": cur > num,
                "<": cur < num, "==": cur == num, "!=": cur != num}[op]
    try:
        parts_or = re.split(r"\|\|", condition)
        for grp in parts_or:
            if all(one(m) for m in [COND_RE.search(p) for p in re.split(r"&&", grp)] if m):
                return True
        return False
    except Exception:
        return True


def col_to_qcolor(txt):
    try:
        r, g, b = (float(x) for x in str(txt).split()[:3])
        return QColor(int(r * 255), int(g * 255), int(b * 255))
    except Exception:
        return QColor(255, 255, 255)


def qcolor_to_we(c):
    return f"{c.red()/255:.5f} {c.green()/255:.5f} {c.blue()/255:.5f}"


# ------------------------------------------------------------------ Properties-Editor
class PropertyEditor(QScrollArea):
    """Baut aus dem project.json-Schema dynamisch Bedienelemente."""

    def __init__(self, on_change):
        super().__init__()
        self.on_change = on_change
        self.setWidgetResizable(True)
        self.setFrameShape(QFrame.NoFrame)
        self.body = QWidget()
        self.form = QFormLayout(self.body)
        self.form.setLabelAlignment(Qt.AlignLeft)
        self.setWidget(self.body)
        self.schema, self.values, self.rows, self.editable = {}, {}, {}, True

    def clear(self):
        while self.form.count():
            it = self.form.takeAt(0)
            if it.widget():
                it.widget().deleteLater()
        self.rows = {}

    def build(self, schema, overrides, editable=True):
        self.clear()
        self.schema = schema or {}
        self.editable = editable
        self.values = {k: (overrides.get(k) if k in overrides else v.get("value"))
                       for k, v in self.schema.items() if isinstance(v, dict)}
        if not self.schema:
            self.form.addRow(QLabel(_("Dieses Wallpaper bietet keine Einstellungen.")))
            return
        ordered = sorted(
            ((k, v) for k, v in self.schema.items() if isinstance(v, dict)),
            key=lambda kv: (kv[1].get("order", 0), kv[0]))
        for key, spec in ordered:
            w = self.make_widget(key, spec)
            if w is None:
                continue
            label = QLabel(nice_label(spec.get("text"), key))
            label.setWordWrap(True)
            self.form.addRow(label, w)
            self.rows[key] = (label, w, spec)
        self.apply_conditions()

    def make_widget(self, key, spec):
        t = spec.get("type") or ("slider" if "min" in spec and "max" in spec else "")
        val = self.values.get(key)
        if t == "group":
            lbl = QLabel(f"<b>{nice_label(spec.get('text'), key)}</b>")
            return lbl
        if t == "bool":
            w = QCheckBox()
            w.setChecked(str(val).lower() in ("1", "true", "yes"))
            w.toggled.connect(lambda c, k=key: self.changed(k, "1" if c else "0"))
        elif t == "combo":
            w = QComboBox()
            for opt in spec.get("options") or []:
                w.addItem(str(opt.get("label", opt.get("value"))), str(opt.get("value")))
            i = w.findData(str(val))
            if i >= 0:
                w.setCurrentIndex(i)
            w.currentIndexChanged.connect(
                lambda _, k=key, ww=w: self.changed(k, ww.currentData()))
        elif t == "color":
            w = QPushButton()
            w.setMinimumHeight(26)
            self.paint_button(w, col_to_qcolor(val))
            w.clicked.connect(lambda _, k=key, ww=w: self.pick_color(k, ww))
        elif t == "slider":
            w = QWidget()
            lay = QHBoxLayout(w)
            lay.setContentsMargins(0, 0, 0, 0)
            frac = spec.get("fraction") or (isinstance(spec.get("step"), float))
            lo, hi = float(spec.get("min", 0)), float(spec.get("max", 1))
            sl = QSlider(Qt.Horizontal)
            box = QDoubleSpinBox() if frac else QSpinBox()
            steps = 1000 if frac else max(1, int(hi - lo))
            sl.setRange(0, steps)
            try:
                cur = float(val)
            except (TypeError, ValueError):
                cur = lo
            if frac:
                box.setDecimals(min(4, int(spec.get("precision", 3) or 3)))
                box.setRange(lo, hi)
                box.setSingleStep(float(spec.get("step", 0.01) or 0.01))
            else:
                box.setRange(int(lo), int(hi))
            box.setValue(cur)
            box.setMaximumWidth(96)
            sl.setValue(int((cur - lo) / (hi - lo) * steps) if hi > lo else 0)

            def from_slider(v, lo=lo, hi=hi, steps=steps, box=box):
                box.setValue(lo + (hi - lo) * v / steps)

            def from_box(v, k=key, sl=sl, lo=lo, hi=hi, steps=steps):
                sl.blockSignals(True)
                sl.setValue(int((v - lo) / (hi - lo) * steps) if hi > lo else 0)
                sl.blockSignals(False)
                self.changed(k, f"{v:g}")
            sl.valueChanged.connect(from_slider)
            box.valueChanged.connect(from_box)
            lay.addWidget(sl, 1)
            lay.addWidget(box)
        elif t in ("textinput", "text"):
            w = QLineEdit(str(val or ""))
            w.textEdited.connect(lambda s, k=key: self.changed(k, s))
        elif t == "file":
            w = QLabel(f"<i>{val or '—'}</i>  " + _("(Datei, nicht editierbar)"))
        else:
            return None
        w.setEnabled(self.editable or t == "group")
        return w

    @staticmethod
    def paint_button(btn, color):
        btn.setStyleSheet(
            f"background-color: {color.name()}; border: 1px solid #666; border-radius: 3px;")
        btn.setText(color.name())

    def pick_color(self, key, btn):
        c = QColorDialog.getColor(col_to_qcolor(self.values.get(key)), self,
                                  _("Farbe waehlen"))
        if c.isValid():
            self.paint_button(btn, c)
            self.changed(key, qcolor_to_we(c))

    def changed(self, key, value):
        self.values[key] = value
        self.apply_conditions()
        if self.editable:
            self.on_change(key, value)

    def apply_conditions(self):
        for key, (label, widget, spec) in self.rows.items():
            ok = cond_ok(spec.get("condition"), self.values)
            label.setVisible(ok)
            widget.setVisible(ok)


