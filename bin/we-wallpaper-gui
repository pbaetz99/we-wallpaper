def nice_label(raw, key):
    if not raw:
        return key.replace("_", " ").strip().title()
    if raw in UI_KEYS:
        return _(UI_KEYS[raw])
    if raw.startswith("ui_"):
        return raw.split("_")[-1].replace("-", " ").title()
    return raw


