# --------------------------------------------------------------- Sprache
# Deutsch ist die Quellsprache der Strings; alles andere bekommt Englisch.
# Erzwingen mit WE_LANG=de|en.
def _detect_lang():
    for var in ("WE_LANG", "LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var) or ""
        if v:
            return "de" if v.lower().startswith("de") else "en"
    return "en"


