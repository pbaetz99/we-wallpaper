#!/usr/bin/env python3
"""Steuerung fuer linux-wallpaperengine.

Befehle: start | stop | restart | status | list | rotate-daemon
Konfiguration: ~/.config/we-wallpaper.json  (Quelle der Wahrheit, von der GUI geschrieben)
"""
import json
import os
import random
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
# Pfad zum Renderer; per WE_RENDERER ueberschreibbar (auch in den systemd-Units
# via `systemctl --user set-environment WE_RENDERER=/pfad` setzbar).
BIN = Path(os.environ.get("WE_RENDERER") or
           HOME / ".local/src/linux-wallpaperengine/build/output/linux-wallpaperengine")
WORKSHOP = HOME / ".local/share/Steam/steamapps/workshop/content/431960"
CONF = HOME / ".config/we-wallpaper.json"
LEGACY = HOME / ".config/we-wallpaper.conf"
STATE = HOME / ".local/state"
LOG = STATE / "we-wallpaper.log"
PIDFILE = STATE / "we-wallpaper.pid"
OUTPUTS_FILE = STATE / "we-wallpaper-outputs.json"   # {Prozess-PID: [Monitore]}
ROTPID = STATE / "we-wallpaper-rotate.pid"
WATCHPID = STATE / "we-wallpaper-watch.pid"
WATCHER = HOME / ".local/bin/we-wallpaper-watch"
WATCHLOG = STATE / "we-wallpaper-watch.log"
UNITDIR = HOME / ".config/systemd/user"
UNIT_RENDER = "we-wallpaper.service"
UNIT_WATCH = "we-wallpaper-watch.service"

DEFAULTS = {
    "screens": {},          # name -> {id, scaling, clamp, properties:{}}
    "fps": 30,
    "volume": 15,
    "silent": False,
    "noautomute": True,
    "no_audio_processing": False,
    "disable_particles": False,
    "disable_mouse": False,
    "disable_parallax": False,
    "no_fullscreen_pause": False,
    "pause_on_fullscreen": True,   # eigene Erkennung per KWin-Skript
    "pause_on_lock": True,         # Sperrbildschirm: Renderer einfrieren
    "pause_on_maximized": True,    # alle Monitore von maximierten Fenstern verdeckt
    "rotation": {"enabled": False, "minutes": 30, "pool": [],
                 "order": "random", "index": 0},
    "renderer": "",         # Pfad zum linux-wallpaperengine-Binary; leer = Standard
    "backend": "native",    # native = linux-wallpaperengine | kde-plugin = wallpaper-engine-kde-plugin
                            # | owe = waywallen + Open Wallpaper Engine (Desktop-Icons bleiben, alle Typen)
    "per_output": False,    # ein Renderer-Prozess je Monitor -> Pausieren pro Monitor moeglich
    "span_pause_any": False, # Span schon pausieren, wenn EIN Monitor verdeckt ist (statt alle)
    "layer": "background",  # wlr-layer-shell-Ebene: background|bottom|top|overlay
                            # 'bottom' verdeckt auf Plasma die Desktop-Icons
    "spans": [],           # [{outputs:[...], id, scaling, clamp, properties}]
    "profiles": {},        # Name -> gespeicherter Satz aller Einstellungen
}


# ---------------------------------------------------------------- Konfiguration
def migrate_legacy():
    """Uebernimmt die alte Bash-Config einmalig."""
    cfg = dict(DEFAULTS)
    cfg["screens"] = {}
    txt = LEGACY.read_text(encoding="utf-8", errors="replace")
    block = re.search(r"SCREENS=\((.*?)\)", txt, re.S)
    if block:
        for line in block.group(1).splitlines():
            line = line.split("#", 1)[0]
            m = re.search(r'"\s*([^"=\s]+)=([^":\s]+)(?::([^"\s]+))?\s*"', line)
            if m and m.group(2).isdigit():
                cfg["screens"][m.group(1)] = {
                    "id": m.group(2), "scaling": m.group(3) or "fill",
                    "clamp": "clamp", "properties": {}}
    m = re.search(r"^\s*FPS=(\d+)", txt, re.M)
    if m:
        cfg["fps"] = int(m.group(1))
    return cfg


def apply_renderer_override(cfg):
    """Renderer-Pfad: WE_RENDERER > Config "renderer" > Standard."""
    global BIN
    if os.environ.get("WE_RENDERER"):
        return
    custom = (cfg or {}).get("renderer") or ""
    if custom:
        BIN = Path(custom).expanduser()


def load_conf():
    cfg = _load_conf_raw()
    apply_renderer_override(cfg)
    return cfg


def _load_conf_raw():
    if CONF.is_file():
        try:
            cfg = dict(DEFAULTS)
            cfg.update(json.loads(CONF.read_text(encoding="utf-8")))
            rot = dict(DEFAULTS["rotation"])
            rot.update(cfg.get("rotation") or {})
            cfg["rotation"] = rot
            return cfg
        except Exception as e:
            print(f"Config unlesbar ({e}) - benutze Standardwerte", file=sys.stderr)
            return dict(DEFAULTS)
    if LEGACY.is_file():
        cfg = migrate_legacy()
        save_conf(cfg)
        print(f"Alte Config uebernommen -> {CONF}", file=sys.stderr)
        return cfg
    return dict(DEFAULTS)


def save_conf(cfg):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(json.dumps(cfg, indent=2, ensure_ascii=False), encoding="utf-8")


# ---------------------------------------------------------------- Hilfsfunktionen
def enabled_outputs():
    """Namen der eingeschalteten Monitore; leer wenn nicht ermittelbar."""
    try:
        out = subprocess.run(["kscreen-doctor", "-j"], capture_output=True,
                             text=True, timeout=5).stdout
        return {o["name"] for o in json.loads(out).get("outputs", [])
                if o.get("enabled") and o.get("name")}
    except Exception:
        return set()


def title_of(wid):
    try:
        d = json.loads((WORKSHOP / wid / "project.json").read_text(
            encoding="utf-8", errors="replace"))
        return d.get("title") or wid
    except Exception:
        return wid


def stray_pids():
    """Alle laufenden Renderer-Prozesse - ermittelt ueber /proc/<pid>/exe,
    also ohne Musterraten wie bei pkill. Faengt auch Prozesse ein, die von
    einer aelteren Version oder einem abgebrochenen Lauf uebrig sind."""
    try:
        target = BIN.resolve()
    except OSError:
        return []
    found = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if Path(os.readlink(entry / "exe")).resolve() == target:
                found.append(int(entry.name))
        except (OSError, ValueError):
            continue
    return found


def proc_state(pid):
    """Prozesszustand laut /proc ('T' = per Signal angehalten)."""
    try:
        data = (Path("/proc") / str(pid) / "stat").read_text()
        return data[data.rindex(")") + 2]
    except (OSError, ValueError):
        return None


def unit_active(unit):
    r = systemctl("is-active", unit)
    return bool(r and r.stdout.strip() == "active")




def rescue_frozen():
    """Weckt eingefrorene Renderer auf, wenn kein Watcher mehr lebt.
    Faengt den Fall ab, dass der Watcher hart abgeschossen wurde."""
    frozen = [p for p in stray_pids() if proc_state(p) == "T"]
    if not frozen:
        return False
    if read_pid(WATCHPID) or (service_enabled() and unit_active(UNIT_WATCH)):
        return False        # Watcher lebt, der regelt das selbst
    for pid in frozen:
        try:
            os.kill(pid, signal.SIGCONT)
        except OSError:
            pass
    print(f"  Renderer {', '.join(map(str, frozen))} war(en) eingefroren und "
          f"wurde(n) befreit (kein Watcher aktiv)")
    return True


def read_pid(path):
    try:
        pid = int(path.read_text().strip())
    except Exception:
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


def _bg_block(target_flag, target_value, sc):
    """Ein --screen-root/--screen-span-Block samt Skalierung und Properties."""
    block = [target_flag, target_value, "--bg", str(sc.get("id")),
             "--scaling", sc.get("scaling") or "fill"]
    if sc.get("clamp"):
        block += ["--clamp", sc["clamp"]]
    for pname, pval in (sc.get("properties") or {}).items():
        block += ["--set-property", f"{pname}={pval}"]
    return block


def build_arg_groups(cfg):
    """Wie build_args, aber je Renderer-Prozess getrennt.

    Ergebnis: (groups, skipped) mit groups = [(monitorliste, args)]. Im
    Standardmodus ist das genau eine Gruppe mit allen Monitoren; bei
    per_output eine Gruppe je Monitor (Spans bleiben je ein Prozess), damit der
    Watcher einzelne Monitore einfrieren kann.
    """
    args, skipped = build_args(cfg)
    if not args:
        return [], skipped
    tail_start = None
    for i, a in enumerate(args):
        if a == "--layer" or a == "--fps":
            tail_start = i
            break
    tail = args[tail_start:] if tail_start is not None else []
    head = args[:tail_start] if tail_start is not None else args
    # head in Bloecke je --screen-root/--screen-span zerlegen
    blocks, cur, outs = [], [], []
    for i, a in enumerate(head):
        if a in ("--screen-root", "--screen-span") and cur:
            blocks.append((outs, cur)); cur, outs = [], []
        if a in ("--screen-root", "--screen-span"):
            outs = head[i + 1].split(",")
        cur.append(a)
    if cur:
        blocks.append((outs, cur))
    if not cfg.get("per_output"):
        all_outs = [o for outs_, _ in blocks for o in outs_]
        return [(all_outs, head + tail)], skipped
    return [(outs_, blk + tail) for outs_, blk in blocks], skipped


def build_args(cfg):
    """Baut die Kommandozeile. Gibt (args, skipped) zurueck."""
    avail = enabled_outputs()
    args, skipped = [], []
    spanned = set()

    # Zuerst Wallpaper, die ueber mehrere Monitore gespannt werden.
    for span in cfg.get("spans") or []:
        outs = [o for o in (span.get("outputs") or []) if o]
        wid = str(span.get("id") or "")
        if len(outs) < 2:
            skipped.append(f"Span {outs}: mindestens zwei Monitore noetig")
            continue
        if not wid.isdigit() or not (WORKSHOP / wid).is_dir():
            skipped.append(f"Span {','.join(outs)}: Wallpaper {wid!r} unbrauchbar")
            continue
        if avail and not all(o in avail for o in outs):
            aus = [o for o in outs if o not in avail]
            skipped.append(f"Span {','.join(outs)}: {', '.join(aus)} ausgeschaltet")
            continue
        args += _bg_block("--screen-span", ",".join(outs), span)
        spanned.update(outs)

    for name, sc in sorted(cfg.get("screens", {}).items()):
        if name in spanned:
            skipped.append(f"{name}: durch einen Span belegt")
            continue
        wid = str(sc.get("id") or "")
        if not wid.isdigit():
            skipped.append(f"{name}: ungueltige ID {wid!r}")
            continue
        if not (WORKSHOP / wid).is_dir():
            skipped.append(f"{name}: Wallpaper {wid} nicht abonniert")
            continue
        if avail and name not in avail:
            skipped.append(f"{name}: Monitor ausgeschaltet")
            continue
        args += _bg_block("--screen-root", name, sc)
    if not args:
        return [], skipped

    layer = cfg.get("layer") or "background"
    if layer in ("background", "bottom", "top", "overlay"):
        args += ["--layer", layer]
    args += ["--fps", str(cfg.get("fps", 30))]
    if cfg.get("silent"):
        args.append("--silent")
    else:
        args += ["--volume", str(cfg.get("volume", 15))]
    for key, flag in (("noautomute", "--noautomute"),
                      ("no_audio_processing", "--no-audio-processing"),
                      ("disable_particles", "--disable-particles"),
                      ("disable_mouse", "--disable-mouse"),
                      ("disable_parallax", "--disable-parallax"),
                      ("no_fullscreen_pause", "--no-fullscreen-pause")):
        if cfg.get(key):
            args.append(flag)
    return args, skipped


# ---------------------------------------------------------------- systemd
RENDER_UNIT_TEXT = """[Unit]
Description=Wallpaper Engine Renderer (linux-wallpaperengine)
Documentation=https://github.com/Almamu/linux-wallpaperengine
PartOf=plasma-workspace.target
# After=plasma-core.target, NICHT plasma-workspace.target: zusammen mit
# WantedBy=plasma-workspace.target ergaebe das einen Ordering-Zyklus, und
# systemd loescht dann den Start-Job ("Job ... deleted to break ordering cycle").
# plasma-core.target garantiert, dass KWin fuer Layer-Shell und Skripte steht.
After=plasma-core.target

[Service]
Type=simple
ExecStart=@BINDIR@/we-wallpaper run-renderer
Restart=on-failure
RestartSec=5
# Beim Stoppen zuverlaessig auch eingefrorene Prozesse einsammeln
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=plasma-workspace.target
"""

WATCH_UNIT_TEXT = """[Unit]
Description=Wallpaper Engine Vollbild-Pause (KWin-Erkennung)
PartOf=plasma-workspace.target
After=we-wallpaper.service
# Bewusst kein Requires=/Requisite= auf we-wallpaper.service: das propagiert
# die Deaktivierung, und der Watcher wuerde beim Wallpaper-Toggle mitsterben -
# danach fehlt der Empfaenger fuer das Einschalt-Tastenkuerzel. Der Watcher
# vertraegt einen fehlenden Renderer von sich aus.

[Service]
Type=simple
ExecStart=@BINDIR@/we-wallpaper-watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=plasma-workspace.target
"""


def systemctl(*args, check=False):
    try:
        return subprocess.run(["systemctl", "--user", *args],
                              capture_output=True, text=True, timeout=30)
    except Exception:
        return None


def service_installed():
    return (UNITDIR / UNIT_RENDER).is_file()


def service_enabled():
    r = systemctl("is-enabled", UNIT_RENDER)
    return bool(r and r.stdout.strip() == "enabled")


def do_install_service():
    UNITDIR.mkdir(parents=True, exist_ok=True)
    # Units zeigen auf das Verzeichnis, aus dem dieses Skript laeuft - so
    # funktionieren ~/.local/bin (install.sh) und /usr/bin (RPM) gleichermassen.
    bindir = str(Path(sys.argv[0]).resolve().parent)
    (UNITDIR / UNIT_RENDER).write_text(RENDER_UNIT_TEXT.replace("@BINDIR@", bindir), encoding="utf-8")
    (UNITDIR / UNIT_WATCH).write_text(WATCH_UNIT_TEXT.replace("@BINDIR@", bindir), encoding="utf-8")
    systemctl("daemon-reload")
    # Der Autostart-Eintrag wuerde sonst doppelt starten
    auto = HOME / ".config/autostart/we-wallpaper.desktop"
    if auto.is_file():
        auto.unlink()
        print("  Autostart-Eintrag entfernt (systemd uebernimmt)")
    r = systemctl("enable", "--now", UNIT_RENDER, UNIT_WATCH)
    if r and r.returncode != 0:
        print(r.stderr.strip(), file=sys.stderr)
        return 1
    print(f"Dienste installiert und aktiviert: {UNIT_RENDER}, {UNIT_WATCH}")
    return 0


def do_uninstall_service():
    systemctl("disable", "--now", UNIT_RENDER, UNIT_WATCH)
    for u in (UNIT_RENDER, UNIT_WATCH):
        f = UNITDIR / u
        if f.is_file():
            f.unlink()
    systemctl("daemon-reload")
    print("Dienste entfernt")
    return 0


def do_run_renderer():
    """Vordergrundmodus fuer systemd: ersetzt den eigenen Prozess durch den
    Renderer, damit systemd ihn direkt ueberwacht und neu starten kann."""
    cfg = load_conf()
    if (cfg.get("backend") or "native") != "native":
        print(f"Backend ist {cfg.get('backend')} - eigener Renderer bleibt aus", file=sys.stderr)
        return 0
    args, skipped = build_args(cfg)
    for item in skipped:
        print(f"uebersprungen: {item}", file=sys.stderr)
    if not args:
        print("kein nutzbarer Monitor konfiguriert", file=sys.stderr)
        return 1
    groups, _ = build_arg_groups(cfg)
    STATE.mkdir(parents=True, exist_ok=True)
    if len(groups) == 1:
        PIDFILE.write_text(str(os.getpid()))   # execv behaelt die PID
        write_outputs_map({os.getpid(): groups[0][0]})
        os.execv(str(BIN), [str(BIN)] + args)
    # per_output: dieser Prozess bleibt als Aufseher, startet je Monitor einen
    # Renderer, startet abgestuerzte neu und gibt SIGTERM an alle weiter.
    children = {}

    def start(outs, gargs):
        p = subprocess.Popen([str(BIN)] + gargs, stdin=subprocess.DEVNULL,
                             start_new_session=True)
        children[p.pid] = (p, outs, gargs)
        write_outputs_map({pid: c[1] for pid, c in children.items()})
        return p

    stopping = {"flag": False}

    def on_term(*_):
        stopping["flag"] = True
        for pid, (p, _o, _a) in list(children.items()):
            try:
                os.kill(pid, signal.SIGCONT)
                p.terminate()
            except OSError:
                pass

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    for outs, gargs in groups:
        start(outs, gargs)
    PIDFILE.write_text(str(next(iter(children))))
    while children and not stopping["flag"]:
        pid, status = os.wait()
        if pid in children and not stopping["flag"]:
            _p, outs, gargs = children.pop(pid)
            print(f"Renderer fuer {','.join(outs)} beendet ({status}) - Neustart in 3s",
                  file=sys.stderr)
            time.sleep(3)
            start(outs, gargs)
            PIDFILE.write_text(str(next(iter(children))))
    for pid, (p, _o, _a) in list(children.items()):
        try:
            p.wait(timeout=5)
        except Exception:
            p.kill()
    OUTPUTS_FILE.unlink(missing_ok=True)
    return 0


# ---------------------------------------------------------------- Backend: KDE-Plugin
# Alternative zum eigenen Renderer: das wallpaper-engine-kde-plugin (catsout)
# rendert INNERHALB von Plasmas Wallpaper-Ebene - Desktop-Icons bleiben sichtbar.
# Umgeschaltet wird ueber Plasmas Scripting-Schnittstelle (org.kde.PlasmaShell
# evaluateScript), die das Wallpaper-Plugin jedes Desktops und dessen Config
# setzen kann. Der eigene Renderer wird dabei gestoppt.
KDE_PLUGIN_ID = "com.github.catsout.wallpaperEngineKde"
KDE_PLUGIN_URL = "https://github.com/catsout/wallpaper-engine-kde-plugin"
# Suchorte fuer das Plugin; Tests setzen die Liste auf ein Temp-Verzeichnis
KDE_PLUGIN_ROOTS = [HOME / ".local/share/plasma/wallpapers",
                    Path("/usr/share/plasma/wallpapers"),
                    Path("/usr/local/share/plasma/wallpapers")]
# Typen, die das Plugin hier zuverlaessig rendert. Ein Scene-Wallpaper hat mit dem
# Scene-Backend des Plugins plasmashell mit SIGABRT abgeschossen (fehlende
# Render-Targets/Assets) - deshalb nur mit --force.
KDE_PLUGIN_SAFE_TYPES = {"video", "web"}
STEAM_LIB = HOME / ".local/share/Steam"


def kde_plugin_dir():
    """Verzeichnis des installierten Plugins - gesucht unter allen Orten, an
    denen Plasma Wallpaper-Plugins laedt (Distributionspakete legen es nach
    /usr/share/plasma/wallpapers, manuelle Installationen nach ~/.local/share)."""
    for root in KDE_PLUGIN_ROOTS:
        if not root.is_dir():
            continue
        for d in sorted(root.iterdir()):
            if d.is_dir() and "wallpaperenginekde" in d.name.lower() and (d / "metadata.json").is_file():
                return d
    return None


def kde_plugin_installed():
    return kde_plugin_dir() is not None


def kde_plugin_id():
    d = kde_plugin_dir()
    if d:
        try:
            return json.loads((d / "metadata.json").read_text(encoding="utf-8"))["KPlugin"]["Id"]
        except Exception:
            return d.name
    return KDE_PLUGIN_ID


def plasma_script(js):
    """Fuehrt ein Plasma-Skript aus; gibt dessen print()-Ausgabe zurueck."""
    r = subprocess.run(["busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell",
                        "org.kde.PlasmaShell", "evaluateScript", "s", js],
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "evaluateScript fehlgeschlagen")
    out = r.stdout.strip()
    # busctl liefert: s "text"
    return json.loads(out[2:]) if out.startswith("s ") else out


def _js_str(v):
    return json.dumps(str(v))


def current_wallpaper_plugins():
    """{Connector-Name oder Screen-Index: Plugin-ID} aller Desktops."""
    js = (
        'var out = {}; var ds = desktops();'
        'for (var i = 0; i < ds.length; i++) { var d = ds[i]; if (d.screen < 0) continue;'
        '  var name = String(d.screen);'
        '  try { if (typeof screenGeometry === "function") { name = String(d.screen); } } catch (e) {}'
        '  out[name] = d.wallpaperPlugin; }'
        'print(JSON.stringify(out));')
    try:
        return json.loads(plasma_script(js) or "{}")
    except Exception:
        return {}


def build_kde_plugin_script(cfg, wallpaper_id):
    """Plasma-Skript, das das KDE-Plugin aktiviert und konfiguriert."""
    pid = kde_plugin_id()
    ws = str(WORKSHOP / wallpaper_id)
    # Das Plugin erwartet in WallpaperSource "<Ordner>/<Datei>+<Typ>" (siehe
    # Common.packWallpaperSource) und waehlt nach dem Typ sein Backend
    # (scene / video / web). Eine nackte URL ergibt "Source is empty".
    try:
        pj = json.loads((WORKSHOP / wallpaper_id / "project.json").read_text(
            encoding="utf-8", errors="replace"))
    except Exception:
        pj = {}
    wfile = pj.get("file") or "scene.json"
    wtype = (pj.get("type") or "scene").lower()
    packed = f"{ws}/{wfile}+{wtype}"
    return (
        'var ds = desktops();'
        'for (var i = 0; i < ds.length; i++) {'
        '  var d = ds[i]; if (d.screen < 0) continue;'
        f'  d.wallpaperPlugin = {_js_str(pid)};'
        f'  d.currentConfigGroup = ["Wallpaper", {_js_str(pid)}, "General"];'
        f'  d.writeConfig("SteamLibraryPath", {_js_str("file://" + str(STEAM_LIB))});'
        f'  d.writeConfig("WallpaperWorkShopId", {_js_str(wallpaper_id)});'
        f'  d.writeConfig("WallpaperSource", {_js_str(packed)});'
        f'  d.writeConfig("Fps", {int(cfg.get("fps", 30))});'
        f'  d.writeConfig("Volume", {int(cfg.get("volume", 15))});'
        f'  d.writeConfig("MuteAudio", {"true" if cfg.get("silent") else "false"});'
        f'  d.writeConfig("MouseInput", {"false" if cfg.get("disable_mouse") else "true"});'
        '  d.writeConfig("PauseMode", 0);'
        '}'
        f'print("ok:" + ds.length);'
    )


def build_native_restore_script():
    return (
        'var ds = desktops(); var n = 0;'
        'for (var i = 0; i < ds.length; i++) { var d = ds[i]; if (d.screen < 0) continue;'
        '  if (d.wallpaperPlugin === ' + _js_str(kde_plugin_id()) + ') { d.wallpaperPlugin = "org.kde.image"; n++; } }'
        'print("restored:" + n);')


def wallpaper_type(wid):
    try:
        return (json.loads((WORKSHOP / str(wid) / "project.json").read_text(
            encoding="utf-8", errors="replace")).get("type") or "scene").lower()
    except Exception:
        return "scene"


# ---------------------------------------------------------------- Backend: waywallen + Open Wallpaper Engine
# waywallen (MIT) ist ein Wallpaper-Daemon mit Plasma-Erweiterung, die in Plasmas
# eigener Wallpaper-Ebene rendert - Desktop-Icons bleiben sichtbar. Das Plugin
# Open Wallpaper Engine (OWE) bringt Renderer fuer scene/video/web-Wallpaper mit.
# Gesteuert wird ueber D-Bus (Port-Abfrage) und einen WebSocket mit Protobuf.
# Der Codec unten ist bewusst abhaengigkeitsfrei (Fedoras python3-protobuf ist
# zu alt fuer generierte Bindings); die Feldnummern stammen aus
# share/wwproto/control.proto (waywallen 0.3.9).
OWE_APP = "org.waywallen.waywallen"
OWE_KDE_ID = "org.waywallen.kde"
OWE_PLUGIN_ID = "org.waywallen.open-wallpaper-engine"
OWE_URL = "https://github.com/waywallen/open-wallpaper-engine"
OWE_BUS = ("org.waywallen.waywallen.Daemon", "/org/waywallen/waywallen/Daemon",
           "org.waywallen.waywallen.Daemon1")
OWE_LOG = STATE / "we-owe.log"
OWE_PLUGIN_DIRS = [
    HOME / f".var/app/{OWE_APP}/data/waywallen/plugins/{OWE_PLUGIN_ID}",
    Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "waywallen/plugins" / OWE_PLUGIN_ID,
]
OWE_REQ = {   # Request/Response-Feldnummern (oneof payload)
    "renderer_list": 12, "wallpaper_list": 19, "wallpaper_scan": 20, "wallpaper_apply": 22,
    "display_list": 23, "settings_get": 24, "settings_set": 25, "wallpaper_get": 42,
    "wallpaper_property_set": 43, "autostart_get": 65, "autostart_set": 66,
    "global_pause_toggle": 75, "global_pause_set": 76, "global_stop_set": 78,
}
OWE_STATUS_OK = 1
OWE_ACTION = {"none": 0, "mute": 1, "pause": 2, "stop": 3}
OWE_RENDER_STATE = {1: "startet", 2: "laeuft", 3: "stoppt", 4: "gestoppt", 5: "abgeschossen", 6: "fehlgeschlagen"}


def pb_varint(n):
    out = bytearray()
    while True:
        b = n & 0x7F
        n >>= 7
        if n:
            out.append(b | 0x80)
        else:
            out.append(b)
            return bytes(out)


def _pb_read_varint(buf, i):
    shift = n = 0
    while True:
        b = buf[i]
        i += 1
        n |= (b & 0x7F) << shift
        if not b & 0x80:
            return n, i
        shift += 7


def pb_decode(buf):
    """Protobuf-Bytes -> Liste (feld, wiretyp, wert). Verschachtelte Nachrichten
    und Strings bleiben rohe Bytes; unbekannte Felder ueberleben ein Decode/Encode."""
    fields, i, n = [], 0, len(buf)
    while i < n:
        key, i = _pb_read_varint(buf, i)
        fno, wt = key >> 3, key & 7
        if wt == 0:
            v, i = _pb_read_varint(buf, i)
        elif wt == 1:
            v, i = bytes(buf[i:i + 8]), i + 8
        elif wt == 5:
            v, i = bytes(buf[i:i + 4]), i + 4
        elif wt == 2:
            ln, i = _pb_read_varint(buf, i)
            v, i = bytes(buf[i:i + ln]), i + ln
        else:
            raise ValueError(f"Protobuf: unbekannter Wiretyp {wt}")
        fields.append((fno, wt, v))
    return fields


def pb_encode(fields):
    out = bytearray()
    for fno, wt, v in fields:
        out += pb_varint((fno << 3) | wt)
        if wt == 0:
            out += pb_varint(int(v))
        elif wt == 2:
            if isinstance(v, str):
                v = v.encode()
            elif isinstance(v, list):
                v = pb_encode(v)
            out += pb_varint(len(v)) + v
        else:
            out += bytes(v)
    return bytes(out)


def pb_get(fields, fno, default=None):
    for f, _wt, v in fields:
        if f == fno:
            return v
    return default


def pb_all(fields, fno):
    return [v for f, _wt, v in fields if f == fno]


def pb_str(fields, fno, default=""):
    v = pb_get(fields, fno)
    return v.decode("utf-8", "replace") if isinstance(v, bytes) else default


def pb_int(fields, fno, default=0):
    v = pb_get(fields, fno)
    return int(v) if isinstance(v, int) else default


def pb_msg(fields, fno):
    v = pb_get(fields, fno)
    return pb_decode(v) if isinstance(v, bytes) else None


def pb_set(fields, fno, wt, value):
    return [f for f in fields if f[0] != fno] + [(fno, wt, value)]


class OweSocket:
    """Kleiner WebSocket-Client (RFC 6455, nur was der Daemon braucht)."""

    def __init__(self, port, timeout=60):
        import base64
        import socket
        self.s = socket.create_connection(("127.0.0.1", int(port)), timeout=timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET / HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\n"
                        f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                        "Sec-WebSocket-Version: 13\r\n\r\n").encode())
        hdr = b""
        while b"\r\n\r\n" not in hdr:
            chunk = self.s.recv(4096)
            if not chunk:
                raise ConnectionError("WebSocket-Handshake abgebrochen")
            hdr += chunk
        head, _, self.buf = hdr.partition(b"\r\n\r\n")
        status = head.split(b"\r\n")[0].decode(errors="replace")
        if " 101 " not in status:
            raise ConnectionError(f"WebSocket-Handshake: {status}")
        self.seq = 0

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass

    def _read(self, n):
        while len(self.buf) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise ConnectionError("waywallen hat die Verbindung geschlossen")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def send(self, payload):
        import struct
        mask = os.urandom(4)
        ln = len(payload)
        if ln < 126:
            hdr = bytes([0x82, 0x80 | ln])
        elif ln < 65536:
            hdr = bytes([0x82, 0x80 | 126]) + struct.pack(">H", ln)
        else:
            hdr = bytes([0x82, 0x80 | 127]) + struct.pack(">Q", ln)
        self.s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def recv(self):
        import struct
        message = b""
        while True:
            b0, b1 = self._read(2)
            fin, op, ln = b0 & 0x80, b0 & 0x0F, b1 & 0x7F
            if ln == 126:
                ln = struct.unpack(">H", self._read(2))[0]
            elif ln == 127:
                ln = struct.unpack(">Q", self._read(8))[0]
            mask = self._read(4) if b1 & 0x80 else None
            data = self._read(ln)
            if mask:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            if op == 8:
                raise ConnectionError("waywallen hat die Verbindung geschlossen")
            if op == 9:      # Ping -> Pong
                self.s.sendall(bytes([0x8A, 0x80 | len(data)]) + b"\0\0\0\0" + data)
                continue
            if op == 10:
                continue
            message += data
            if fin:
                return message
        return message

    def call(self, name, payload=b""):
        """Sendet Request{request_id, <name>: payload} und liefert die Antwort-
        Nutzlast als dekodierte Feldliste; Fehler des Daemons werden geworfen."""
        self.seq += 1
        rid = self.seq
        self.send(pb_encode([(1, 0, rid), (OWE_REQ[name], 2, payload)]))
        while True:
            frame = pb_decode(self.recv())
            resp = pb_msg(frame, 1)          # ServerFrame.response (2 = Event)
            if resp is None or pb_int(resp, 1) != rid:
                continue
            if pb_int(resp, 2) != OWE_STATUS_OK:
                raise RuntimeError(f"waywallen {name}: {pb_str(resp, 3) or 'Fehler'} "
                                   f"(status {pb_int(resp, 2)}, code {pb_int(resp, 4)})")
            return pb_msg(resp, OWE_REQ[name]) or []


def owe_flatpak_installed():
    return any((base / "app" / OWE_APP / "current/active/metadata").is_file()
               for base in (HOME / ".local/share/flatpak", Path("/var/lib/flatpak")))


def owe_kde_installed():
    return any((root / OWE_KDE_ID / "metadata.json").is_file() for root in KDE_PLUGIN_ROOTS)


def owe_plugin_dir():
    for d in OWE_PLUGIN_DIRS:
        if (d / "bin/waywallen-wescene-renderer").is_file():
            return d
    return None


def owe_installer():
    """Pfad des Einrichtungsskripts: Repo, ~/.local/share oder RPM."""
    here = Path(__file__).resolve().parent.parent / "packaging/install-owe.sh"
    for p in (here, HOME / ".local/share/we-wallpaper/install-owe.sh",
              Path("/usr/share/we-wallpaper/install-owe.sh")):
        if p.is_file():
            return str(p)
    return "packaging/install-owe.sh"


def owe_missing():
    """Was fuer das OWE-Backend fehlt - Liste von (Text, Hinweis)."""
    out = []
    inst = owe_installer()
    if not owe_flatpak_installed():
        out.append(("waywallen (Flatpak org.waywallen.waywallen)",
                    f"{inst}  (oder: flatpak install --user flathub org.waywallen.waywallen)"))
    if not owe_kde_installed():
        out.append(("Plasma-Erweiterung org.waywallen.kde",
                    f"{inst}  (holt waywallen-kde von GitHub und installiert es per kpackagetool6)"))
    if not owe_plugin_dir():
        out.append(("Plugin Open Wallpaper Engine",
                    f"{inst}  (entpackt das Bundle von {OWE_URL} nach ~/.var/app/{OWE_APP}/data/waywallen/plugins/)"))
    return out


def owe_bus_prop(name):
    """Liest eine D-Bus-Property des Daemons; None wenn er nicht laeuft."""
    try:
        r = subprocess.run(["busctl", "--user", "get-property", *OWE_BUS, name],
                           capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    typ, _, val = r.stdout.strip().partition(" ")
    if typ == "s":
        return val.strip('"')
    if typ in ("u", "i", "t", "x", "q", "n", "y"):
        return int(val)
    return val


def owe_running():
    return owe_bus_prop("WsPort") is not None


def owe_start_daemon(wait=30):
    if owe_running():
        return True
    STATE.mkdir(parents=True, exist_ok=True)
    with open(OWE_LOG, "a") as lf:
        subprocess.Popen(["flatpak", "run", "--command=waywallen", OWE_APP, "--no-ui"],
                         stdout=lf, stderr=lf, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(wait * 2):
        time.sleep(0.5)
        if owe_running():
            time.sleep(2)   # Display-Registrierung der Plasma-Erweiterung abwarten
            return True
    return False


def owe_connect():
    port = owe_bus_prop("WsPort")
    if port is None:
        raise RuntimeError("waywallen-Daemon laeuft nicht (we-wallpaper owe start)")
    return OweSocket(port)


def owe_catalog(ws):
    """Alle Wallpaper, die waywallen kennt - mit Workshop-ID (external_id)."""
    out, page = [], 0
    while True:
        r = ws.call("wallpaper_list", pb_encode([(2, 0, page), (3, 0, 200)]))
        entries = [pb_decode(x) for x in pb_all(r, 1)]
        if not entries:
            break
        for e in entries:
            out.append({"id": pb_str(e, 1), "name": pb_str(e, 2), "type": pb_str(e, 3),
                        "resource": pb_str(e, 4), "preview": pb_str(e, 5),
                        "width": pb_int(e, 8), "height": pb_int(e, 9), "workshop": pb_str(e, 15)})
        if len(out) >= pb_int(r, 2):
            break
        page += 1
    return out


def owe_find(catalog, wid):
    wid = str(wid)
    for e in catalog:
        if e["workshop"] == wid or f"/{wid}/" in e["resource"] + "/":
            return e
    return None


def owe_displays(ws):
    r = ws.call("display_list")
    return [{"id": pb_int(d, 1), "name": pb_str(d, 2), "w": pb_int(d, 3), "h": pb_int(d, 4)}
            for d in (pb_decode(x) for x in pb_all(r, 1))]


def output_sizes():
    """{Ausgabename: (Breite, Hoehe)} der aktiven Monitore per kscreen-doctor."""
    try:
        r = subprocess.run(["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=10)
        data = json.loads(r.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}
    out = {}
    for o in data.get("outputs", []):
        if not o.get("enabled"):
            continue
        mode = next((m for m in o.get("modes", []) if m.get("id") == o.get("currentModeId")), None)
        size = (mode or {}).get("size") or {}
        if size:
            out[o.get("name")] = (int(size.get("width", 0)), int(size.get("height", 0)))
    return out


def owe_plan(cfg, displays, sizes):
    """Reine Zuordnung Monitor-Config -> waywallen-Displays: {display_id: workshop_id}.
    Gleiche Aufloesung entscheidet; bleibt etwas unzugeordnet, bekommt es das
    erste zugewiesene Wallpaper (waywallen benennt Displays nicht nach Ausgang)."""
    screens = {n: str(sc.get("id")) for n, sc in sorted((cfg.get("screens") or {}).items())
               if str(sc.get("id") or "").isdigit()}
    plan, used = {}, set()
    for name, wid in screens.items():
        size = sizes.get(name)
        d = next((d for d in displays if d["id"] not in used and size and (d["w"], d["h"]) == size), None)
        if d:
            plan[d["id"]] = wid
            used.add(d["id"])
    first = next(iter(screens.values()), None)
    for d in displays:
        if d["id"] not in plan and first:
            plan[d["id"]] = first
    return plan


def owe_apply_plan(ws, plan, catalog=None):
    """Wendet einen Plan an; liefert [(workshop_id, katalogname, [display_ids])]."""
    catalog = catalog if catalog is not None else owe_catalog(ws)
    by_wid = {}
    for did, wid in plan.items():
        by_wid.setdefault(wid, []).append(did)
    done = []
    for wid, dids in by_wid.items():
        entry = owe_find(catalog, wid)
        if entry is None:
            ws.call("wallpaper_scan")
            catalog = owe_catalog(ws)
            entry = owe_find(catalog, wid)
        if entry is None:
            raise RuntimeError(f"Wallpaper {wid} ({title_of(wid)}) ist waywallen unbekannt - "
                               "in der waywallen-UI die Steam-Workshop-Quelle hinzufuegen")
        payload = [(1, 2, entry["id"])] + [(5, 2, pb_encode([(1, 0, did)])) for did in dids]
        ws.call("wallpaper_apply", pb_encode(payload))
        done.append((wid, entry["name"], dids))
    return done


def owe_apply(cfg, ws=None):
    ws = ws or owe_connect()
    displays = owe_displays(ws)
    if not displays:
        raise RuntimeError("waywallen meldet kein Display - ist das Plasma-Wallpaper auf "
                           f"{OWE_KDE_ID} gestellt? (we-wallpaper backend owe)")
    plan = owe_plan(cfg, displays, output_sizes())
    if not plan:
        raise RuntimeError("kein Wallpaper zugewiesen - erst in der GUI zuweisen")
    return owe_apply_plan(ws, plan)


def owe_pause(paused, ws=None):
    ws = ws or owe_connect()
    ws.call("global_pause_set", pb_encode([(1, 0, 1 if paused else 0)]))


def owe_sync_policy(cfg, ws=None):
    """Uebertraegt pause_on_* in waywallens auto_replay-Politik (Vollbild=13,
    Maximiert=12, Sperre=14); alle anderen Einstellungen bleiben unangetastet."""
    ws = ws or owe_connect()
    sg = ws.call("settings_get")
    g = pb_msg(sg, 1) or []
    plugins = [(2, 2, p) for p in pb_all(sg, 2)]
    ar = pb_msg(g, 16) or []
    for fno, key in ((13, "pause_on_fullscreen"), (12, "pause_on_maximized"), (14, "pause_on_lock")):
        ar = pb_set(ar, fno, 0, OWE_ACTION["pause"] if cfg.get(key, True) else OWE_ACTION["none"])
    g = pb_set(g, 16, 2, pb_encode(ar))
    ws.call("settings_set", pb_encode([(1, 2, pb_encode(g))] + plugins))


def owe_renderers(ws):
    r = ws.call("renderer_list")
    out = []
    for inst in (pb_decode(x) for x in pb_all(r, 2)):
        state = pb_msg(inst, 17) or []
        kind = state[0][0] if state else 0
        out.append({"id": pb_str(inst, 1), "name": pb_str(inst, 4), "pid": pb_int(inst, 5),
                    "fps": pb_int(inst, 2), "state": OWE_RENDER_STATE.get(kind, "?")})
    return out


def build_owe_script():
    return (f'for (const d of desktops()) {{ d.wallpaperPlugin = {_js_str(OWE_KDE_ID)}; }}\n'
            f'print("owe ok");')


def owe_status_lines(cfg):
    lines = []
    if not owe_running():
        lines.append("waywallen: laeuft nicht  (we-wallpaper owe start)")
        return lines
    lines.append(f"waywallen {owe_bus_prop('Version')} laeuft, WebSocket-Port {owe_bus_prop('WsPort')}")
    try:
        ws = owe_connect()
        try:
            catalog = owe_catalog(ws)
            cur = str(owe_bus_prop("CurrentWallpaperId") or "")
            entry = next((e for e in catalog if e["id"] == cur), None)
            lines.append("aktuell: " + (f"{entry['name']} [{entry['type']}] "
                                        f"(Workshop {entry['workshop'] or '-'})" if entry else "-"))
            for r in owe_renderers(ws):
                lines.append(f"Renderer {r['name']} PID {r['pid']}: {r['state']}, {r['fps']} fps")
            lines.append(f"Katalog: {len(catalog)} Wallpaper, {len(owe_displays(ws))} Display(s)")
        finally:
            ws.close()
    except (OSError, RuntimeError) as e:
        lines.append(f"Steuerkanal: {e}")
    return lines


def do_owe(args):
    """Direkte Steuerung von waywallen: we-wallpaper owe <Befehl>."""
    cfg = load_conf()
    cmd = args[0] if args else "status"
    if cmd == "start":
        ok = owe_start_daemon()
        print("waywallen laeuft" if ok else f"waywallen startet nicht - siehe {OWE_LOG}")
        return 0 if ok else 1
    if cmd == "stop":
        subprocess.run(["flatpak", "kill", OWE_APP], capture_output=True)
        print("waywallen beendet")
        return 0
    if cmd == "status":
        for line in owe_status_lines(cfg):
            print(line)
        return 0
    try:
        ws = owe_connect()
    except (OSError, RuntimeError) as e:
        print(e, file=sys.stderr)
        return 1
    try:
        if cmd == "list":
            for e in owe_catalog(ws):
                print(f"{e['id']:>4}  {e['type']:<6} {e['workshop'] or '-':<11} {e['name']}")
            return 0
        if cmd == "scan":
            r = ws.call("wallpaper_scan")
            print(f"{pb_int(r, 1)} Wallpaper gefunden")
            return 0
        if cmd == "apply":
            if len(args) > 1:
                dids = [d["id"] for d in owe_displays(ws)]
                done = owe_apply_plan(ws, {d: str(args[1]) for d in dids})
            else:
                done = owe_apply(cfg, ws)
            for wid, name, dids in done:
                print(f"{name} (Workshop {wid}) auf Display {', '.join(map(str, dids))}")
            return 0
        if cmd == "pause":
            what = args[1] if len(args) > 1 else "toggle"
            if what == "toggle":
                ws.call("global_pause_toggle")
            else:
                owe_pause(what in ("on", "1", "true", "an"), ws)
            print("ok")
            return 0
        if cmd == "policy":
            owe_sync_policy(cfg, ws)
            print("Pausen-Politik uebertragen")
            return 0
        if cmd == "prop" and len(args) >= 4:
            entry = owe_find(owe_catalog(ws), args[1])
            if entry is None:
                print(f"Wallpaper {args[1]} unbekannt", file=sys.stderr)
                return 1
            ws.call("wallpaper_property_set", pb_encode([(1, 2, entry["id"]), (2, 2, args[2]), (3, 2, args[3])]))
            print("ok")
            return 0
        print("Aufruf: we-wallpaper owe status|start|stop|list|scan|apply [Workshop-ID]"
              "|pause [on|off|toggle]|policy|prop <Workshop-ID> <Schluessel> <Wert>", file=sys.stderr)
        return 1
    except (OSError, RuntimeError) as e:
        print(e, file=sys.stderr)
        return 1
    finally:
        ws.close()


def owe_leave():
    """Autostart von waywallen abschalten und den Daemon beenden."""
    try:
        ws = owe_connect()
        try:
            ws.call("autostart_set", pb_encode([(1, 0, 0)]))
        finally:
            ws.close()
    except (OSError, RuntimeError):
        pass
    subprocess.run(["flatpak", "kill", OWE_APP], capture_output=True)


def do_backend(target=None, force=False):
    cfg = load_conf()
    if target is None:
        cur = cfg.get("backend") or "native"
        print(f"aktiv: {cur}")
        print(f"KDE-Plugin installiert: {'ja' if kde_plugin_installed() else 'nein'}")
        print(f"OWE (waywallen) einsatzbereit: {'ja' if not owe_missing() else 'nein'}")
        plugs = current_wallpaper_plugins()
        if plugs:
            print("Plasma-Wallpaper-Plugins: " + ", ".join(f"{k}={v}" for k, v in plugs.items()))
        return 0
    if target not in ("native", "kde-plugin", "owe"):
        print("Aufruf: we-wallpaper backend [native|kde-plugin|owe]", file=sys.stderr)
        return 1
    previous = cfg.get("backend") or "native"
    if target == "owe":
        missing = owe_missing()
        if missing:
            print("Fuer das OWE-Backend fehlt:", file=sys.stderr)
            for text, hint in missing:
                print(f"  - {text}\n      -> {hint}", file=sys.stderr)
            return 2
        do_stop(quiet=True)
        if service_enabled():
            systemctl("disable", "--now", UNIT_RENDER)
        if not owe_start_daemon():
            print(f"waywallen startet nicht - siehe {OWE_LOG}", file=sys.stderr)
            return 1
        try:
            out = plasma_script(build_owe_script())
        except Exception as e:      # noqa: BLE001 - Plasma-Fehler nur melden
            out = f"Plasma nicht erreichbar: {e}"
        cfg["backend"] = "owe"
        save_conf(cfg)
        try:
            ws = owe_connect()
            try:
                ws.call("autostart_set", pb_encode([(1, 0, 1)]))
                owe_sync_policy(cfg, ws)
                time.sleep(1)
                done = owe_apply(cfg, ws)
            finally:
                ws.close()
        except (OSError, RuntimeError) as e:
            print(f"OWE aktiv, aber: {e}", file=sys.stderr)
            return 1
        if service_installed() and cfg.get("pause_on_fullscreen"):
            systemctl("enable", "--now", UNIT_WATCH)
        for wid, name, dids in done:
            print(f"OWE: {name} (Workshop {wid}) auf Display {', '.join(map(str, dids))}")
        print(f"Plasma: {out}")
        return 0
    if target == "kde-plugin":
        if not kde_plugin_installed():
            print("wallpaper-engine-kde-plugin ist nicht installiert.\n"
                  f"  Quelle: {KDE_PLUGIN_URL}\n"
                  "  Fedora/Nobara: COPR kylegospo/wallpaper-engine-kde-plugin",
                  file=sys.stderr)
            return 2
        screens = cfg.get("screens") or {}
        wid = next((str(sc.get("id")) for _n, sc in sorted(screens.items()) if sc.get("id")), "")
        if not wid.isdigit():
            print("kein Wallpaper zugewiesen - erst in der GUI zuweisen", file=sys.stderr)
            return 1
        wtype = wallpaper_type(wid)
        if wtype not in KDE_PLUGIN_SAFE_TYPES and not force and not cfg.get("kde_plugin_allow_scene"):
            print(f"Wallpaper {wid} ({title_of(wid)}) ist vom Typ '{wtype}'. Das Scene-Backend des\n"
                  "KDE-Plugins rendert viele Szenen nicht (unbekannte Render-Targets) und hat\n"
                  "ungepatcht plasmashell zum Absturz gebracht; zuverlaessig sind video und web.\n"
                  "  Trotzdem versuchen: we-wallpaper backend kde-plugin --force\n"
                  "  Dauerhaft erlauben:  \"kde_plugin_allow_scene\": true in der Config",
                  file=sys.stderr)
            return 3
        do_stop(quiet=True)
        if service_enabled():
            systemctl("disable", "--now", UNIT_RENDER, UNIT_WATCH)
        if previous == "owe":
            owe_leave()
        out = plasma_script(build_kde_plugin_script(cfg, wid))
        cfg["backend"] = "kde-plugin"
        save_conf(cfg)
        print(f"KDE-Plugin aktiv mit Wallpaper {wid} ({title_of(wid)}) - Plasma: {out}")
        return 0
    # zurueck auf den eigenen Renderer
    if previous == "owe":
        owe_leave()
    try:
        out = plasma_script(build_native_restore_script())
    except Exception as e:
        out = f"Plasma nicht erreichbar: {e}"
    cfg["backend"] = "native"
    save_conf(cfg)
    if service_installed():
        systemctl("enable", "--now", UNIT_RENDER, UNIT_WATCH)
        time.sleep(5)
    else:
        spawn(cfg)
        time.sleep(4)
    print(f"eigener Renderer aktiv - Plasma: {out}")
    return do_status()


# ---------------------------------------------------------------- Aktionen
def kill_pidfile(path):
    pid = read_pid(path)
    if pid:
        try:
            os.kill(pid, signal.SIGCONT)   # falls per SIGSTOP eingefroren
        except OSError:
            pass
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        for _ in range(30):
            time.sleep(0.1)
            try:
                os.kill(pid, 0)
            except OSError:
                break
        else:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    path.unlink(missing_ok=True)
    return bool(pid)


def do_stop(quiet=False):
    if service_enabled():
        systemctl("stop", UNIT_WATCH, UNIT_RENDER)
        rescue_frozen()
        # systemd raeumt nur, was in seinen Units haengt - aus fruehreren
        # Laeufen uebrige Renderer muessen trotzdem weg
        strays = stray_pids()
        for pid in strays:
            try:
                os.kill(pid, signal.SIGCONT)
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        if strays:
            time.sleep(0.5)
            for pid in stray_pids():
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
        PIDFILE.unlink(missing_ok=True)
        if not quiet:
            extra = f", {len(strays)} verwaiste(r) Renderer beendet" if strays else ""
            print(f"gestoppt (systemd){extra}")
        return True
    kill_pidfile(WATCHPID)          # zuerst: entsperrt den Renderer beim Beenden
    rot = kill_pidfile(ROTPID)
    was = kill_pidfile(PIDFILE)
    strays = stray_pids()
    for pid in strays:
        try:
            os.kill(pid, signal.SIGCONT)
            os.kill(pid, signal.SIGTERM)
        except OSError:
            continue
    if strays:
        time.sleep(0.5)
        for pid in stray_pids():
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        if not quiet:
            print(f"zusaetzlich {len(strays)} verwaiste(n) Renderer beendet")
    if not quiet:
        print("gestoppt" if (was or rot or strays) else "lief nicht")
    return was or bool(strays)


def write_outputs_map(mapping):
    STATE.mkdir(parents=True, exist_ok=True)
    OUTPUTS_FILE.write_text(json.dumps({str(k): v for k, v in mapping.items()}))


def spawn(cfg):
    groups, skipped = build_arg_groups(cfg)
    for s in skipped:
        print(f"uebersprungen: {s}", file=sys.stderr)
    if not groups:
        print("kein nutzbarer Monitor konfiguriert - nichts gestartet")
        return False
    STATE.mkdir(parents=True, exist_ok=True)
    mapping = {}
    with open(LOG, "w") as log:
        for outs, args in groups:
            p = subprocess.Popen([str(BIN)] + args, stdout=log, stderr=log,
                                 stdin=subprocess.DEVNULL, start_new_session=True)
            mapping[p.pid] = outs
    PIDFILE.write_text(str(next(iter(mapping))))
    write_outputs_map(mapping)
    return True


def do_start():
    cfg = load_conf()
    if (cfg.get("backend") or "native") == "owe":
        if not owe_start_daemon():
            print(f"waywallen startet nicht - siehe {OWE_LOG}", file=sys.stderr)
            return 1
        try:
            ws = owe_connect()
            try:
                owe_sync_policy(cfg, ws)
                done = owe_apply(cfg, ws)
            finally:
                ws.close()
        except (OSError, RuntimeError) as e:
            print(e, file=sys.stderr)
            return 1
        for wid, name, dids in done:
            print(f"OWE: {name} (Workshop {wid}) auf Display {', '.join(map(str, dids))}")
        if service_installed():
            systemctl("restart", UNIT_WATCH) if cfg.get("pause_on_fullscreen") \
                else systemctl("stop", UNIT_WATCH)
        return do_status()
    if service_enabled():
        systemctl("restart", UNIT_RENDER)
        systemctl("restart", UNIT_WATCH) if cfg.get("pause_on_fullscreen") \
            else systemctl("stop", UNIT_WATCH)
        time.sleep(5)
        return do_status()
    do_stop(quiet=True)
    if not spawn(cfg):
        return 1
    time.sleep(5)
    if cfg.get("pause_on_fullscreen") and WATCHER.is_file():
        STATE.mkdir(parents=True, exist_ok=True)
        with open(WATCHLOG, "w") as wl:
            wp = subprocess.Popen([sys.executable, str(WATCHER)], stdout=wl,
                                  stderr=wl, stdin=subprocess.DEVNULL,
                                  start_new_session=True)
        WATCHPID.write_text(str(wp.pid))
    rot = cfg.get("rotation") or {}
    if rot.get("enabled") and len(rot.get("pool") or []) > 1:
        r = subprocess.Popen([sys.executable, __file__, "rotate-daemon"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             stdin=subprocess.DEVNULL, start_new_session=True)
        ROTPID.write_text(str(r.pid))
    do_status()
    return 0


def do_rotate_daemon():
    """Wechselt in festem Takt die Wallpaper aus dem Pool."""
    while True:
        cfg = load_conf()
        rot = cfg.get("rotation") or {}
        pool = [w for w in (rot.get("pool") or []) if (WORKSHOP / str(w)).is_dir()]
        if not rot.get("enabled") or len(pool) < 2:
            return
        time.sleep(max(1, int(rot.get("minutes", 30))) * 60)
        cfg = load_conf()
        rot = cfg.get("rotation") or {}
        if not rot.get("enabled"):
            return
        if not advance_rotation(cfg):
            return
        if (cfg.get("backend") or "native") == "owe":
            try:
                owe_apply(load_conf())
            except (OSError, RuntimeError) as e:
                print(f"Diashow: {e}", file=sys.stderr)
            continue
        if service_enabled():
            systemctl("restart", UNIT_RENDER)
        else:
            kill_pidfile(PIDFILE)
            spawn(load_conf())


# Schluessel, die ein Profil umfasst (alles ausser den Profilen selbst)
PROFILE_KEYS = [k for k in DEFAULTS if k != "profiles"]


def do_profiles():
    cfg = load_conf()
    profs = cfg.get("profiles") or {}
    if not profs:
        print("keine Profile gespeichert")
        return 0
    for name in sorted(profs):
        p = profs[name]
        screens = p.get("screens") or {}
        parts = [f"{n}={(sc or {}).get('id')}" for n, sc in sorted(screens.items())]
        print(f"  {name}: fps={p.get('fps')}  {', '.join(parts) or 'keine Monitore'}")
    return 0


def do_profile(name):
    cfg = load_conf()
    profs = cfg.get("profiles") or {}
    if name not in profs:
        print(f"Profil {name!r} gibt es nicht. Vorhanden: "
              f"{', '.join(sorted(profs)) or '(keine)'}", file=sys.stderr)
        return 1
    saved = profs[name]
    for key in PROFILE_KEYS:
        if key in saved:
            cfg[key] = saved[key]
    save_conf(cfg)
    print(f"Profil {name!r} aktiviert")
    return do_start()


def watch_active():
    """Laeuft die Vollbild-Erkennung - egal ob per PID-Datei oder als Dienst?"""
    if read_pid(WATCHPID):
        return True
    return service_enabled() and unit_active(UNIT_WATCH)


def advance_rotation(cfg):
    """Setzt auf jedem Monitor das naechste Wallpaper aus dem Pool.

    Reihenfolge "random" meidet das aktuelle Bild, "sequential" laeuft den Pool
    stur durch. Properties werden verworfen, weil sie nur zu ihrem eigenen
    Wallpaper passen.
    """
    rot = cfg.setdefault("rotation", {})
    pool = [str(w) for w in (rot.get("pool") or [])
            if (WORKSHOP / str(w)).is_dir()]
    if len(pool) < 2:
        return False
    order = rot.get("order") or "random"
    idx = int(rot.get("index") or 0)
    targets = list(cfg.get("screens", {}).items())
    for span in cfg.get("spans") or []:
        targets.append((None, span))
    if not targets:
        return False
    for _name, sc in targets:
        if order == "sequential":
            idx = (idx + 1) % len(pool)
            sc["id"] = pool[idx]
        else:
            choices = [w for w in pool if w != str(sc.get("id"))] or pool
            sc["id"] = random.choice(choices)
        sc["properties"] = {}
    rot["index"] = idx
    save_conf(cfg)
    return True


def do_toggle():
    """Nur den Renderer aus/an - laesst den Watcher ausdruecklich in Ruhe.

    Wichtig: der Watcher ruft diese Aktion selbst auf. Wuerde sie (wie 'stop')
    auch die Watcher-Unit stoppen, brachte sich der Aufrufer mitten in der
    Aktion selbst um und liesse verwaiste Renderer zurueck.
    """
    if (load_conf().get("backend") or "native") == "owe":
        try:
            ws = owe_connect()
            try:
                ws.call("global_pause_toggle")
            finally:
                ws.close()
        except (OSError, RuntimeError) as e:
            print(e, file=sys.stderr)
            return 1
        print("Wallpaper-Pause umgeschaltet")
        return 0
    running = read_pid(PIDFILE) is not None or bool(stray_pids())
    if running:
        if service_enabled():
            systemctl("stop", UNIT_RENDER)
        kill_pidfile(PIDFILE)
        for pid in stray_pids():
            try:
                os.kill(pid, signal.SIGCONT)
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass
        time.sleep(0.5)
        for pid in stray_pids():
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        print("Wallpaper aus")
        return 0
    if service_enabled():
        systemctl("start", UNIT_RENDER)
        time.sleep(4)
    else:
        spawn(load_conf())
        time.sleep(4)
    print("Wallpaper an")
    return 0


def do_next():
    cfg = load_conf()
    if not advance_rotation(cfg):
        print("Diashow-Pool braucht mindestens zwei Wallpaper", file=sys.stderr)
        return 1
    if (cfg.get("backend") or "native") == "owe":
        try:
            owe_apply(load_conf())
        except (OSError, RuntimeError) as e:
            print(e, file=sys.stderr)
            return 1
        return do_status()
    if service_enabled():
        systemctl("restart", UNIT_RENDER)
        time.sleep(4)
    else:
        kill_pidfile(PIDFILE)
        spawn(load_conf())
        time.sleep(4)
    return do_status()


def do_status():
    cfg = load_conf()
    if (cfg.get("backend") or "native") == "owe":
        print("Backend: waywallen + Open Wallpaper Engine (Desktop-Icons sichtbar)")
        for line in owe_status_lines(cfg):
            print("  " + line)
        print(f"  Watcher: {'aktiv' if unit_active(UNIT_WATCH) else 'aus'}")
        return 0
    rescue_frozen()
    pid = read_pid(PIDFILE)
    avail = enabled_outputs()
    strays = [s for s in stray_pids() if s != pid]
    if pid:
        rot = cfg.get("rotation") or {}
        extra = ""
        if read_pid(ROTPID):
            extra = f", Diashow alle {rot.get('minutes', 30)} min"
        if watch_active():
            extra += ", Vollbild-Pause aktiv"
        if service_enabled():
            extra += ", als systemd-Dienst"
        frozen = ""
        allp = stray_pids()
        if len(allp) > 1:
            extra += f", {len(allp)} Renderer-Prozesse"
        if any(proc_state(p) == "T" for p in allp) or proc_state(pid) == "T":
            reason = "?"
            try:
                reason = json.loads((STATE / "we-wallpaper-pause.json").read_text()).get("reason") or "?"
            except Exception:
                pass
            frozen = f"  [eingefroren: {reason}]"
        print(f"running (pid {pid}), fps={cfg.get('fps', 30)}{extra}{frozen}")
    else:
        print(f"not running — siehe {LOG}")
    if strays:
        print(f"  WARNUNG: {len(strays)} verwaiste(r) Renderer laeuft mit "
              f"(PID {', '.join(map(str, strays))}) - 'we-wallpaper stop' raeumt auf")
    for name, sc in sorted(cfg.get("screens", {}).items()):
        wid = str(sc.get("id") or "")
        mark = "" if (not avail or name in avail) else "  (Monitor aus)"
        props = sc.get("properties") or {}
        pn = f"  [{len(props)} Property-Aenderungen]" if props else ""
        print(f"  {name}: {wid}  [{sc.get('scaling', 'fill')}]{mark}  "
              f"{title_of(wid)}{pn}")
    return 0


def do_list():
    if not WORKSHOP.is_dir():
        print(f"Workshop-Ordner fehlt: {WORKSHOP}", file=sys.stderr)
        return 1
    for d in sorted(WORKSHOP.iterdir()):
        pj = d / "project.json"
        if not pj.is_file():
            continue
        try:
            j = json.loads(pj.read_text(encoding="utf-8", errors="replace"))
        except Exception:
            j = {}
        print(f"  {d.name:<12} [{(j.get('type') or '?'):<6}] {j.get('title') or d.name}")
    return 0


def do_doctor():
    """Prueft alle Voraussetzungen und sagt konkret, was fehlt."""
    import shutil
    cfg = load_conf()
    checks = []

    def add(ok, text, hint=""):
        checks.append((ok, text, hint))

    add(os.environ.get("XDG_SESSION_TYPE") == "wayland",
        f"Wayland-Sitzung (XDG_SESSION_TYPE={os.environ.get('XDG_SESSION_TYPE', '?')})",
        "Der Renderer braucht unter Plasma eine Wayland-Sitzung (Layer-Shell).")
    add("KDE" in os.environ.get("XDG_CURRENT_DESKTOP", ""),
        f"KDE Plasma (XDG_CURRENT_DESKTOP={os.environ.get('XDG_CURRENT_DESKTOP', '?')})",
        "Vollbild-/Maximiert-Erkennung und Tastenkuerzel nutzen KWin-Scripting.")
    add(BIN.is_file() and os.access(BIN, os.X_OK),
        f"Renderer: {BIN}",
        "linux-wallpaperengine bauen (siehe README) oder Pfad per WE_RENDERER / "
        "Config-Schluessel \"renderer\" setzen.")
    assets = HOME / ".local/share/Steam/steamapps/common/wallpaper_engine/assets"
    add(assets.is_dir(), f"Wallpaper-Engine-Assets: {assets}",
        "Wallpaper Engine in Steam installieren (Proton, 'Steam Play fuer alle Titel').")
    n_items = len([d for d in WORKSHOP.iterdir() if (d / "project.json").is_file()]) \
        if WORKSHOP.is_dir() else 0
    add(n_items > 0, f"Workshop-Wallpaper: {n_items} in {WORKSHOP}",
        "Im Steam-Workshop Wallpaper abonnieren; Steam laedt sie in diesen Ordner.")
    try:
        import PySide6  # noqa: F401
        from PySide6 import QtDBus  # noqa: F401
        add(True, f"PySide6 {PySide6.__version__} inkl. QtDBus")
    except Exception as e:
        add(False, "PySide6 mit QtDBus", f"Fedora: dnf install python3-pyside6 ({e})")
    add(shutil.which("kscreen-doctor") is not None, "kscreen-doctor",
        "Teil von KDE (libkscreen); ohne ihn fehlt die Monitorerkennung.")
    add(shutil.which("ffprobe") is not None, "ffprobe (optional, Videoaufloesung)",
        "ffmpeg installieren, sonst zeigt die GUI keine Aufloesungen.")
    r = subprocess.run(["busctl", "--user", "call", "org.kde.KWin", "/Scripting",
                        "org.kde.kwin.Scripting", "isScriptLoaded", "s", "we-doctor"],
                       capture_output=True, text=True, timeout=10)
    add(r.returncode == 0, "KWin-Scripting per D-Bus erreichbar",
        "Ohne KWin-Scripting keine Vollbild-Pause und keine Tastenkuerzel.")
    r = systemctl("is-system-running")
    add(r is not None and r.returncode in (0, 1), "systemd --user verfuegbar",
        "Ohne User-systemd laufen nur Autostart-Eintrag und manueller Start.")
    add(str(HOME / ".local/bin") in os.environ.get("PATH", "").split(":"),
        "~/.local/bin im PATH",
        "Sonst Befehle mit vollem Pfad aufrufen oder PATH ergaenzen.")
    add(CONF.is_file(), f"Konfiguration: {CONF}",
        "Entsteht beim ersten 'Anwenden' in der GUI oder beim ersten Start.")
    screens = cfg.get("screens") or {}
    add(bool(screens), f"zugewiesene Monitore: {', '.join(sorted(screens)) or 'keine'}",
        "In der GUI ein Wallpaper einem Monitor zuweisen und 'Anwenden'.")
    owe_mode = (cfg.get("backend") or "native") == "owe"
    add(service_installed() if owe_mode else service_enabled(),
        "als systemd-Dienst eingerichtet (empfohlen)" + (" - im OWE-Modus laeuft nur der Watcher" if owe_mode else ""),
        "we-wallpaper install-service")
    add(kde_plugin_installed(), "wallpaper-engine-kde-plugin (optional, fuer Desktop-Icons; video/web)",
        f"Optionales Backend; behaelt Desktop-Icons. packaging/build-kde-plugin.sh oder {KDE_PLUGIN_URL}")
    add(owe_flatpak_installed(), "waywallen (Flatpak; optional, Backend 'owe' mit Desktop-Icons fuer alle Typen)",
        "flatpak install --user flathub org.waywallen.waywallen")
    if owe_flatpak_installed():
        add(owe_kde_installed(), f"Plasma-Erweiterung {OWE_KDE_ID}", owe_installer())
        add(owe_plugin_dir() is not None, "Plugin Open Wallpaper Engine (Renderer fuer scene/video/web)",
            f"{owe_installer()}  ({OWE_URL})")
    if kde_plugin_installed():
        qml_ws = Path("/usr/lib64/qt6/qml/QtWebSockets/qmldir")
        add(qml_ws.is_file(), "QML-Modul QtWebSockets (das Plugin laedt sonst nicht)",
            "Fedora/Nobara: dnf install qt6-qtwebsockets-devel - das QML-Modul liegt im -devel-Paket.")

    bad = 0
    for ok, text, hint in checks:
        print(f"  {'OK ' if ok else 'FEHLT'}  {text}")
        if not ok:
            bad += 1
            if hint:
                print(f"         -> {hint}")
    print(f"\n{len(checks) - bad} von {len(checks)} Pruefungen bestanden.")
    return 1 if bad else 0


def main():
    load_conf()   # setzt u.a. den Renderer-Pfad fuer alle Aktionen
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "doctor":
        return do_doctor()
    if action == "backend":
        return do_backend(sys.argv[2] if len(sys.argv) > 2 else None,
                          force="--force" in sys.argv[3:])
    if action == "start":
        return do_start()
    if action == "restart":
        return do_start()
    if action == "stop":
        do_stop()
        return 0
    if action == "status":
        return do_status()
    if action == "list":
        return do_list()
    if action == "rotate-daemon":
        return do_rotate_daemon()
    if action == "run-renderer":
        return do_run_renderer()
    if action == "install-service":
        return do_install_service()
    if action == "uninstall-service":
        return do_uninstall_service()
    if action == "profiles":
        return do_profiles()
    if action == "profile":
        if len(sys.argv) < 3:
            print("Aufruf: we-wallpaper profile <Name>", file=sys.stderr)
            return 1
        return do_profile(sys.argv[2])
    if action == "toggle":
        return do_toggle()
    if action == "owe":
        return do_owe(sys.argv[2:])
    if action == "next":
        return do_next()
    if action == "thaw":
        frozen = [p for p in stray_pids() if proc_state(p) == "T"]
        for pid in frozen:
            os.kill(pid, signal.SIGCONT)
        print(f"Renderer {', '.join(map(str, frozen))} aufgeweckt" if frozen else "nichts eingefroren")
        return 0
    print("Aufruf: we-wallpaper doctor|backend|start|stop|restart|status|list|thaw|profile|profiles"
          "|next|toggle|owe|install-service|uninstall-service",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main() or 0)
